{
  "expo": {
    "name": "Dabbu - Family Finance",
    "description": "Family Finance, Shared Expenses & Money Goals – Manage money together with the people who matter.",
    "slug": "dabbu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "dabbu",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dabbu.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Dabbu and authenticate payments",
        "NSCameraUsageDescription": "Scan receipts and documents",
        "NSContactsUsageDescription": "Dabbu accesses your contacts to help find friends who are already using the app, making it easy to connect and share expenses.",
        "UIBackgroundModes": ["remote-notification"],
        "NSNotificationUsageDescription": "Dabbu sends notifications for expense updates, payment reminders, and shared finance activity.",
        "NSLocalNotificationUsageDescription": "Dabbu uses local notifications for reminders and alerts."
      },
      "associatedDomains": ["applinks:dabbu.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "app.dabbu.mobile",
      "permissions": ["USE_BIOMETRIC", "CAMERA", "RECEIVE_SMS", "READ_SMS", "POST_NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED", "READ_CONTACTS"]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-font",
      "expo-contacts"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1",
      "environment": "development",
      "googleClientId": "1031730335520-04qfis58v1a073l8pa9ta4blabkeuce8.apps.googleusercontent.com",
      "androidGoogleClientId": "1031730335520-04qfis58v1a073l8pa9ta4blabkeuce8.apps.googleusercontent.com",
      "eas": {
        "projectId": "dabbu-notifications"
      }
    }
  }
}
