{
  "expo": {
    "name": "Dabbu - Family Finance",
    "description": "Family Finance, Shared Expenses & Money Goals – Manage money together with the people who matter.",
    "slug": "dabbu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "dabbu",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5EEFF",
      "image": "./src/assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dabbu.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Dabbu and authenticate payments",
        "NSCameraUsageDescription": "Scan receipts and documents",
        "NSContactsUsageDescription": "Dabbu accesses your contacts to help find friends who are already using the app, making it easy to connect and share expenses.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSNotificationUsageDescription": "Dabbu sends notifications for expense updates, payment reminders, and shared finance activity.",
        "NSLocalNotificationUsageDescription": "Dabbu uses local notifications for reminders and alerts."
      },
      "associatedDomains": [
        "applinks:dabbu.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "app.dabbu.mobile",
      "permissions": [
        "USE_BIOMETRIC",
        "CAMERA",
        "RECEIVE_SMS",
        "READ_SMS",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-contacts"
    ],
    "extra": {
      "apiUrl": "https://dabbu-1ff9.onrender.com/api/v1",
      "inviteUrl": "https://external-web.vercel.app/i",
      "environment": "development",
      "googleClientId": "407187036002-5hh2u40fa00m72oumrfrnnj8genlft9s.apps.googleusercontent.com",
      "androidGoogleClientId": "407187036002-emb73glp4cjdabsng81iod9ukt91ace0.apps.googleusercontent.com",
      "androidDebugGoogleClientId": "407187036002-bj9sonpkhmssd7nfdt9q9ro45u0bq2ip.apps.googleusercontent.com",
      "webGoogleClientId": "407187036002-f25f6fvjurlbqrf1u5vckkob2or1n9mg.apps.googleusercontent.com",
      "eas": {
        "projectId": "57a858a9-aa05-47d4-b908-e3d887e07597"
      }
    },
    "projectId": "57a858a9-aa05-47d4-b908-e3d887e07597",
    "owner": "dabbu1s-team"
  }
}
