  familyId      String    @db.VarChar(36)
  title         String    @db.VarChar(255)
  description   String?   @db.VarChar(500)
  eventType     String    @default("custom") @db.VarChar(30) // birthday, emi, bill_due, insurance_renewal, school_fee, goal_milestone, reminder, custom
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean   @default(false)
  color         String?   @db.VarChar(20)
  recurrence    String?   @db.VarChar(50) // daily, weekly, monthly, yearly, none
  referenceType String?   @db.VarChar(30) // bill, goal, investment, insurance, task
  referenceId   String?   @db.VarChar(36)
  createdBy     String    @db.VarChar(36)
  assignedTo    String?   @db.VarChar(36)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator  User   @relation("CalendarEventCreator", fields: [createdBy], references: [id])
  assignee User?  @relation("CalendarEventAssignee", fields: [assignedTo], references: [id])

  @@index([familyId, startDate])
  @@index([eventType])
  @@map("family_calendar_events")
}

// ─── AI FEED CARDS ─────────────────────────────────────────
// Pre-computed daily feed cards shown in Today Feed screen.
// Generated by cron jobs; never computed on demand.
model AiFeedCard {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  type            String    @db.VarChar(50)
  priority        String    @default("medium") @db.VarChar(20)
  title           String    @db.VarChar(200)
  message         String    @db.Text
  impactValue     Float?
  confidenceScore Float?
  category        String    @db.VarChar(50)
  actionType      String?   @db.VarChar(50)
  actionPayload   Json?     @db.Json
  metadata        Json?     @db.Json
  isRead          Boolean   @default(false)
  isDismissed     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  readAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, priority, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type])
  @@map("ai_feed_cards")
}

// ─── EMI PAYMENT HISTORY ─────────────────────────────────────
// Individual EMI payments recorded against a loan
model EmiPayment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  loanId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  amount    Decimal  @db.Decimal(12, 2)
  paidDate  DateTime @db.Date
  principal Decimal  @default(0) @db.Decimal(12, 2)
  interest  Decimal  @default(0) @db.Decimal(12, 2)
  notes     String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  loan UserLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([userId])
  @@map("emi_payments")
}

// ─── USER LOANS ─────────────────────────────────────────────
// Personal loan tracking (Home, Car, Personal, Education)
model UserLoan {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  name         String    @db.VarChar(100)
  type         String    @default("personal") @db.VarChar(20) // home, car, personal, education, other
  totalAmount  Decimal   @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal   @default(0) @db.Decimal(12, 2)
  interestPaid Decimal   @default(0) @db.Decimal(12, 2)
  interestRate Decimal   @default(0) @db.Decimal(5, 2) // annual interest rate in %
  monthlyEmi   Decimal   @default(0) @db.Decimal(12, 2)
  tenureMonths Int? // total loan tenure in months
  emiDay       Int? // Day of month EMI is due (1-31)
  startDate    DateTime? @db.Date // Loan start date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emiPayments EmiPayment[]

  @@index([userId])
  @@map("user_loans")
}

// ─── USER NET WORTH ─────────────────────────────────────────
// Personal net worth tracking (assets vs liabilities)
model UserNetWorth {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String   @unique @db.VarChar(36)
  totalAssets      Decimal  @default(0) @db.Decimal(14, 2)
  totalLiabilities Decimal  @default(0) @db.Decimal(14, 2)
  bank             Decimal  @default(0) @db.Decimal(14, 2)
  cash             Decimal  @default(0) @db.Decimal(14, 2)
  gold             Decimal  @default(0) @db.Decimal(14, 2)
  stocks           Decimal  @default(0) @db.Decimal(14, 2)
  mutualFunds      Decimal  @default(0) @db.Decimal(14, 2)
  crypto           Decimal  @default(0) @db.Decimal(14, 2)
  property         Decimal  @default(0) @db.Decimal(14, 2)
  investments      Decimal  @default(0) @db.Decimal(14, 2)
  fixedDeposits    Decimal  @default(0) @db.Decimal(14, 2)
  homeLoan         Decimal  @default(0) @db.Decimal(14, 2)
  personalLoan     Decimal  @default(0) @db.Decimal(14, 2)
  creditCardDebt   Decimal  @default(0) @db.Decimal(14, 2)
  otherLiabilities Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_net_worth")
}

// ─── NET WORTH SNAPSHOT ──────────────────────────────
// Monthly history of net worth for trend tracking
model NetWorthSnapshot {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String   @db.VarChar(36)
  snapshotDate     DateTime @db.Date
  totalAssets      Decimal  @default(0) @db.Decimal(14, 2)
  totalLiabilities Decimal  @default(0) @db.Decimal(14, 2)
  netWorth         Decimal  @default(0) @db.Decimal(14, 2)
  bank             Decimal  @default(0) @db.Decimal(14, 2)
  cash             Decimal  @default(0) @db.Decimal(14, 2)
  gold             Decimal  @default(0) @db.Decimal(14, 2)
  stocks           Decimal  @default(0) @db.Decimal(14, 2)
  mutualFunds      Decimal  @default(0) @db.Decimal(14, 2)
  crypto           Decimal  @default(0) @db.Decimal(14, 2)
  property         Decimal  @default(0) @db.Decimal(14, 2)
  investments      Decimal  @default(0) @db.Decimal(14, 2)
  fixedDeposits    Decimal  @default(0) @db.Decimal(14, 2)
  homeLoan         Decimal  @default(0) @db.Decimal(14, 2)
  personalLoan     Decimal  @default(0) @db.Decimal(14, 2)
  creditCardDebt   Decimal  @default(0) @db.Decimal(14, 2)
  otherLiabilities Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

// ─── DASHBOARD WIDGETS ────────────────────────────────────────
// Per-user widget configuration for personal/couple/family dashboards
model DashboardWidget {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  scope      String   @default("personal") @db.VarChar(20) // personal, couple, family
  familyId   String?  @db.VarChar(36)
  widgetType String   @db.VarChar(50) // NET_WORTH, THIS_MONTH, HEALTH_SCORE, etc.
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  config     Json?    @db.Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id])

  @@unique([userId, scope, widgetType])
  @@index([userId, scope, enabled, position])
  @@map("dashboard_widgets")
}

// ─── SPACES (NEW CORE ENTITY) ──────────────────────────
// Standalone Space model — replaces SharedGroup long-term
model Space {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(20) // COUPLE, FAMILY, TRIP, BUSINESS, CUSTOM
  icon      String?  @db.VarChar(50)
  coverColor String? @db.VarChar(20)
  createdBy String   @db.VarChar(36)
  lensId    String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User             @relation("SpaceCreator", fields: [createdBy], references: [id])
  members      SpaceMember[]
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]
  healthScores HealthScore[]
  aiReviews    AiReview[]

  @@index([createdBy])
  @@index([type])
  @@index([lensId])
  @@map("spaces")
}

model SpaceMember {
  id        String   @id @default(uuid()) @db.VarChar(36)
  spaceId   String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  role      String   @default("member") @db.VarChar(20) // owner, admin, member, viewer
  joinedAt  DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

// ─── HEALTH SCORE ─────────────────────────────────────────
// Per-user and per-space financial health score
model HealthScore {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String?  @db.VarChar(36)
  spaceId        String?  @db.VarChar(36)
  entityType     String   @db.VarChar(10) // USER, SPACE
  entityId       String   @db.VarChar(36)
  score          Int      @default(70)
  breakdownJson  Json?    @db.Json
  calculatedAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([userId])
  @@index([spaceId])
  @@map("health_scores")
}

// ─── AI REVIEW ──────────────────────────────────────────
// Periodic AI-generated financial health reviews per user/space
model AiReview {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  spaceId    String?  @db.VarChar(36)
  insight    String   @db.Text
  prediction String?  @db.Text
  score      Int?     @default(70)
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([spaceId])
  @@index([createdAt])
  @@map("ai_reviews")
}

// ═══════════════════════════════════════════════════════════════
// LENS SYSTEM
// ═══════════════════════════════════════════════════════════════

enum LensType {
  PERSONAL
  PARTNERED
  FAMILY
  FULL
}

// ─── LENS ─────────────────────────────────────────────────
// Master lens definitions
model Lens {
  id          String   @id @default(uuid()) @db.VarChar(36)
  type        LensType @unique
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(500)
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userLenses        UserLens[]
  featureFlags      LensFeatureFlag[]
  themeSettings     LensThemeSetting[]
  dashboardConfig   LensDashboardConfig[]
  navigationRules   LensNavigationRule[]
  widgets           LensWidget[]
  quickActions      LensQuickAction[]
  recommendations   LensRecommendation[]
  notificationPrefs LensNotificationPreference[]
  dashboardLayouts  UserDashboardLayout[]

  @@index([sortOrder])
  @@map("lenses")
}

// ─── USER LENS ────────────────────────────────────────────
// Per-user lens preferences and state
model UserLens {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  lensId          String   @db.VarChar(36)
  isOnboarded     Boolean  @default(false)
  onboardingStep  String?  @db.VarChar(50)
  lastSwitchedAt  DateTime?
  switchedCount   Int      @default(0)
  isCustomized    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([userId, lensId])
  @@index([userId])
  @@index([lensId])
  @@map("user_lenses")
}

// ─── LENS FEATURE FLAG ───────────────────────────────────
// What features each lens enables
model LensFeatureFlag {
  id          String   @id @default(uuid()) @db.VarChar(36)
  lensId      String   @db.VarChar(36)
  featureKey  String   @db.VarChar(100)
  enabled     Boolean  @default(false)
  config      Json?    @db.Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, featureKey])
  @@index([lensId])
  @@map("lens_feature_flags")
}

// ─── LENS THEME SETTING ──────────────────────────────────
// Theme overrides per lens
model LensThemeSetting {
  id          String   @id @default(uuid()) @db.VarChar(36)
  lensId      String   @db.VarChar(36)
  paletteKey  String   @db.VarChar(50)
  colorValue  String   @db.VarChar(20)
  cssVar      String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, paletteKey])
  @@index([lensId])
  @@map("lens_theme_settings")
}

// ─── LENS DASHBOARD CONFIG ───────────────────────────────
// Widget configuration per lens
model LensDashboardConfig {
  id          String   @id @default(uuid()) @db.VarChar(36)
  lensId      String   @db.VarChar(36)
  widgetKey   String   @db.VarChar(100)
  widgetType  String   @db.VarChar(50)
  title       String   @db.VarChar(200)
  size        String   @default("medium") @db.VarChar(20)
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  isLocked    Boolean  @default(false)
  config      Json?    @db.Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, widgetKey])
  @@index([lensId])
  @@index([lensId, sortOrder])
  @@map("lens_dashboard_configs")
}

// ─── LENS NAVIGATION RULE ────────────────────────────────
// Bottom tab visibility and ordering per lens
model LensNavigationRule {
  id          String   @id @default(uuid()) @db.VarChar(36)
  lensId      String   @db.VarChar(36)
  tabKey      String   @db.VarChar(50)
  isVisible   Boolean  @default(true)
  isPriority  Boolean  @default(false)
  sortOrder   Int      @default(0)
  icon        String?  @db.VarChar(100)
  label       String?  @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, tabKey])
  @@index([lensId])
  @@index([lensId, sortOrder])
  @@map("lens_navigation_rules")
}

// ─── LENS WIDGET ─────────────────────────────────────────
// Widget definitions available in each lens
model LensWidget {
  id          String   @id @default(uuid()) @db.VarChar(36)
  lensId      String   @db.VarChar(36)
  widgetKey   String   @db.VarChar(100)
  widgetType  String   @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  size        String   @default("medium") @db.VarChar(20)
  isDefault   Boolean  @default(false)
  isRemovable Boolean  @default(true)
  config      Json?    @db.Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, widgetKey])
  @@index([lensId])
  @@map("lens_widgets")
}

// ─── USER DASHBOARD LAYOUT ───────────────────────────────
// Per-user widget customization within a lens
model UserDashboardLayout {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  lensId    String   @db.VarChar(36)
  widgetKey String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  size      String?  @db.VarChar(20)
  config    Json?    @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([userId, lensId, widgetKey])
  @@index([userId, lensId])
  @@index([userId, lensId, sortOrder])
  @@map("user_dashboard_layouts")
}

// ─── LENS QUICK ACTION ───────────────────────────────────
// Quick action button config per lens
model LensQuickAction {
  id        String   @id @default(uuid()) @db.VarChar(36)
  lensId    String   @db.VarChar(36)
  actionKey String   @db.VarChar(100)
  label     String   @db.VarChar(100)
  icon      String?  @db.VarChar(100)
  color     String?  @db.VarChar(20)
  sortOrder Int      @default(0)
  screen    String?  @db.VarChar(200)
  params    Json?    @db.Json
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@unique([lensId, actionKey])
  @@index([lensId])
  @@index([lensId, sortOrder])
  @@map("lens_quick_actions")
}

// ─── LENS RECOMMENDATION ─────────────────────────────────
// Smart recommendations shown per lens
model LensRecommendation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  lensId        String   @db.VarChar(36)
  title         String   @db.VarChar(200)
  description   String?  @db.Text
  actionType    String   @db.VarChar(50)
  actionPayload Json?    @db.Json
  priority      Int      @default(0)
  conditions    Json?    @db.Json
  isActive      Boolean  @default(true)
  dismissible   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@index([lensId, isActive])
  @@index([lensId, priority])
  @@map("lens_recommendations")
}

// ─── LENS SWITCH LOG ─────────────────────────────────────
// Audit trail for every lens switch
model LensSwitchLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  fromLens  LensType
  toLens    LensType
  reason    String?  @db.VarChar(100)
  metadata  Json?    @db.Json
  clientInfo String? @db.VarChar(500)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([toLens])
  @@map("lens_switch_logs")
}

// ─── LENS NOTIFICATION PREFERENCE ────────────────────────
// Which notification channels are active per lens
model LensNotificationPreference {
  id             String   @id @default(uuid()) @db.VarChar(36)
  lensId         String   @db.VarChar(36)
  userId         String   @db.VarChar(36)
  channelKey     String   @db.VarChar(100)
  enabled        Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  emailEnabled   Boolean  @default(false)
  inAppEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lensId, userId, channelKey])
  @@index([lensId, userId])
  @@map("lens_notification_preferences")
}
