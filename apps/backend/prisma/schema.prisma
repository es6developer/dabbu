// ─── PHASE 2: ADVANCED SHARED FINANCE ─────────────────────
// Group Wallet System

model GroupWallet {
  id               String   @id @default(uuid()) @db.VarChar(36)
  groupId          String   @db.VarChar(36)
  name             String   @db.VarChar(255)
  description      String?  @db.VarChar(500)
