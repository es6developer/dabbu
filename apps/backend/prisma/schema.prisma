  notificationType String  @db.VarChar(40)    // member_removed, group_completed, group_archived, group_closed, access_expired, invite_revoked, trip_ended
  title           String   @db.VarChar(255)
  message         String   @db.Text
  actionUrl       String?  @db.VarChar(500)
  actionLabel     String?  @db.VarChar(100)   // "Install Dabbu", "View Summary", "Contact Admin"
  isRead          Boolean  @default(false)
  readAt          DateTime?
  isSent          Boolean  @default(false)
  sentAt          DateTime?
  metadata        Json?    @db.Json
  createdAt       DateTime @default(now())

  @@index([groupId, notificationType])
  @@index([recipientUserId, isRead])
  @@index([recipientTempId, isRead])
  @@index([isSent, createdAt])
  @@map("group_lifecycle_notifications")
}

// ─── AI INSIGHTS: GROUP POLLS ──────────────────────────────
model GroupPoll {
  id        String   @id @default(uuid()) @db.VarChar(36)
  groupId   String   @db.VarChar(36)
  question  String   @db.VarChar(500)
  createdBy String   @db.VarChar(36)
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PollOption[]
  votes   PollVote[]

  @@index([groupId, isActive])
  @@map("group_polls")
}

model PollOption {
  id     String @id @default(uuid()) @db.VarChar(36)
  pollId String @db.VarChar(36)
  text   String @db.VarChar(255)
  sortOrder Int @default(0)

  poll  GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id       String @id @default(uuid()) @db.VarChar(36)
  pollId   String @db.VarChar(36)
  optionId String @db.VarChar(36)
  userId   String @db.VarChar(36)

  poll   GroupPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_votes")
}

// ─── AI INSIGHTS: SHARED GROCERY ───────────────────────────
model SharedGroceryList {
  id          String   @id @default(uuid()) @db.VarChar(36)
  groupId     String   @db.VarChar(36)
  name        String   @db.VarChar(255)
  createdBy   String   @db.VarChar(36)
  totalEstimated Decimal? @db.Decimal(15, 2)
  totalActual    Decimal? @db.Decimal(15, 2)
  status      String   @default("active") @db.VarChar(20)  // active, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  items GroceryItem[]

  @@index([groupId, status])
  @@map("shared_grocery_lists")
}

model GroceryItem {
  id            String   @id @default(uuid()) @db.VarChar(36)
  listId        String   @db.VarChar(36)
  name          String   @db.VarChar(255)
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unit          String   @default("pcs") @db.VarChar(20)
  estimatedPrice Decimal? @db.Decimal(15, 2)
  actualPrice   Decimal? @db.Decimal(15, 2)
  assignedTo    String?  @db.VarChar(36)
  category      String   @default("other") @db.VarChar(50)
  isPurchased   Boolean  @default(false)
  purchasedBy   String?  @db.VarChar(36)
  purchasedAt   DateTime?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  list SharedGroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, isPurchased])
  @@map("grocery_items")
}

// ─── AI INSIGHTS: SAVINGS CHALLENGES ───────────────────────
model SavingsChallenge {
  id             String   @id @default(uuid()) @db.VarChar(36)
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  icon           String   @default("🎯") @db.VarChar(10)
  category       String   @db.VarChar(50)   // no_swiggy, grocery_opt, low_fuel, savings_goal, family_savings
  targetDays     Int      @default(30)
  targetSavings  Decimal? @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  isPublic       Boolean  @default(true)
  createdBy      String   @db.VarChar(36)
  badgeId        String?  @db.VarChar(50)
  startsAt       DateTime @default(now())
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants ChallengeParticipant[]
  badgeEarners ChallengeBadge[]

  @@index([category, isActive])
  @@index([isPublic])
  @@map("savings_challenges")
}

model ChallengeParticipant {
  id           String   @id @default(uuid()) @db.VarChar(36)
  challengeId  String   @db.VarChar(36)
  userId       String   @db.VarChar(36)
  dayCount     Int      @default(0)
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  skipped      Int      @default(0)
  savingsAmount Decimal @default(0) @db.Decimal(15, 2)
  completedToday Boolean @default(false)
  lastCompletedAt DateTime?
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  challenge SavingsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, streak])
  @@map("challenge_participants")
}

model ChallengeBadge {
  id          String   @id @default(uuid()) @db.VarChar(36)
  challengeId String   @db.VarChar(36)
  userId      String   @db.VarChar(36)
  badgeId     String   @db.VarChar(50)
  badgeName   String   @db.VarChar(100)
  badgeEmoji  String   @default("🏅") @db.VarChar(10)
  earnedAt    DateTime @default(now())

  challenge SavingsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, userId])
  @@map("challenge_badges")
}

// ─── AI INSIGHTS: MEMORIES ─────────────────────────────────
model MemoryEntry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @db.VarChar(36)
  type        String   @db.VarChar(30)    // trip, expense, milestone, anniversary
  title       String   @db.VarChar(255)
  description String?  @db.Text
  emoji       String   @default("📸") @db.VarChar(10)
  amount      Decimal? @db.Decimal(15, 2)
  groupId     String?  @db.VarChar(36)
  tripId      String?  @db.VarChar(36)
  expenseId   String?  @db.VarChar(36)
  memberNames Json?    @db.Json
  memoryDate  DateTime
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, type])
  @@index([userId, memoryDate])
  @@index([groupId])
  @@map("memory_entries")
}

// ─── AI INSIGHTS: FINANCIAL REPORTS ────────────────────────
model FinancialReport {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @db.VarChar(36)
  type           String   @db.VarChar(20)    // monthly, yearly, custom
  month          Int?
  year           Int
  reportData     Json     @db.Json
  totalIncome    Decimal  @default(0) @db.Decimal(15, 2)
  totalExpenses  Decimal  @default(0) @db.Decimal(15, 2)
  savings        Decimal  @default(0) @db.Decimal(15, 2)
  insights       Json?    @db.Json
  isGenerated    Boolean  @default(false)
  generatedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, type, year])
  @@index([userId, year, month])
  @@map("financial_reports")
}

// ─── AI INSIGHTS: QR SPLIT SESSIONS ────────────────────────
model QRSplitSession {
  id             String   @id @default(uuid()) @db.VarChar(36)
  groupId        String?  @db.VarChar(36)
  tableName      String   @db.VarChar(100)
  totalAmount    Decimal? @db.Decimal(15, 2)
  currency       String   @default("INR") @db.VarChar(5)
  status         String   @default("active") @db.VarChar(20)  // active, settled, expired
  createdBy      String   @db.VarChar(36)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  settledAt      DateTime?

  participants QRSplitParticipant[]
  items        QRSplitItem[]

  @@index([status, createdAt])
  @@map("qr_split_sessions")
}

model QRSplitParticipant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  sessionId String   @db.VarChar(36)
  name      String   @db.VarChar(100)
  userId    String?  @db.VarChar(36)
  tempId    String?  @db.VarChar(36)
  amount    Decimal? @db.Decimal(15, 2)
  isPaid    Boolean  @default(false)
  joinedAt  DateTime @default(now())

  session QRSplitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("qr_split_participants")
}

model QRSplitItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sessionId   String   @db.VarChar(36)
  name        String   @db.VarChar(255)
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(15, 2)
  assignedTo  String?  @db.VarChar(36)   // participant ID
  createdAt   DateTime @default(now())

  session QRSplitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("qr_split_items")
}

// ─── AI INSIGHTS: LIFE EVENTS ─────────────────────────────
model LifeEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @db.VarChar(36)
  eventType   String   @db.VarChar(50)    // wedding, baby, home, festival, college, bachelor, vacation, other
  eventName   String   @db.VarChar(255)
  description String?  @db.Text
  totalBudget Decimal? @db.Decimal(15, 2)
  currency    String   @default("INR") @db.VarChar(5)
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("planning") @db.VarChar(20)  // planning, ongoing, completed
  isShared    Boolean  @default(false)
  groupId     String?  @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contributors LifeEventContributor[]
  expenses     LifeEventExpense[]

  @@index([userId, eventType])
  @@index([groupId])
  @@map("life_events")
}

model LifeEventContributor {
  id        String   @id @default(uuid()) @db.VarChar(36)
  eventId   String   @db.VarChar(36)
  name      String   @db.VarChar(100)
  userId    String?  @db.VarChar(36)
  amount    Decimal  @default(0) @db.Decimal(15, 2)
  role      String   @default("contributor") @db.VarChar(50)
  createdAt DateTime @default(now())

  event LifeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("life_event_contributors")
}

model LifeEventExpense {
  id          String   @id @default(uuid()) @db.VarChar(36)
  eventId     String   @db.VarChar(36)
  category    String   @db.VarChar(50)   // venue, catering, decoration, travel, gifts, etc.
  description String?  @db.VarChar(500)
  amount      Decimal  @db.Decimal(15, 2)
  paidBy      String?  @db.VarChar(36)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  event LifeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
  @@map("life_event_expenses")
}

// ─── EXPENSE GROUPS (Expenses tab, NOT split groups) ──────
model ExpenseGroup {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  icon          String   @default("users") @db.VarChar(50)
  currency      String   @default("INR") @db.VarChar(10)
  monthlyBudget Decimal? @db.Decimal(15, 2)
  monthlyIncome Decimal? @db.Decimal(15, 2)
  createdBy     String   @db.VarChar(36)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members      ExpenseGroupMember[]
  transactions Transaction[]

  @@index([createdBy])
  @@map("expense_groups")
}

model ExpenseGroupMember {
  id         String   @id @default(uuid()) @db.VarChar(36)
  groupId    String   @db.VarChar(36)
  userId     String   @db.VarChar(36)
  role       String   @default("member") @db.VarChar(20) // admin, member
  addedAt    DateTime @default(now())

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("expense_group_members")
}

// ─── CURRENCIES ─────────────────────────────────────────────
model Currency {
  id       String   @id @default(uuid()) @db.VarChar(36)
  code     String   @unique @db.VarChar(3)
  name     String   @db.VarChar(100)
  symbol   String   @db.VarChar(10)
  locale   String?  @db.VarChar(10)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

