// Audit trail for every group state change

model GroupLifecycleEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  groupId   String   @db.VarChar(36)
  eventType String   @db.VarChar(50) // created, status_changed, member_removed, member_left, invite_revoked, guest_expired, group_frozen, settlements_finalized, report_exported
  fromStatus String? @db.VarChar(20)
  toStatus   String? @db.VarChar(20)
  metadata   Json?   @db.Json // flexible payload: { removedUserId, reason, etc }
  triggeredBy String  @db.VarChar(36) // userId or 'system'
  createdAt  DateTime @default(now())

  group SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([eventType])
  @@map("group_lifecycle_events")
}

model MemberRemovalLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  groupId    String   @db.VarChar(36)
  memberId   String   @db.VarChar(36) // the removed user ID
  removedBy  String   @db.VarChar(36) // admin who removed
  reason     String?  @db.VarChar(500)
  hadOutstandingBalance Boolean @default(false)
  balanceAtRemoval Decimal? @db.Decimal(15, 2)
  invalidationToken String? @db.VarChar(512)
  createdAt  DateTime @default(now())

  group SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  remover User      @relation(fields: [removedBy], references: [id])

  @@index([groupId, createdAt])
  @@index([memberId])
  @@map("member_removal_logs")
}

model SessionRevocation {
  id         String   @id @default(uuid()) @db.VarChar(36)
