// ─── SHARED FINANCE ECOSYSTEM ──────────────────────────────
// Premium shared-finance models for group splits, couples, trips, settlements

model SharedGroup {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  type          String   @default("friends") @db.VarChar(50) // friends, trip, family, couple, roommates, office, event, apartment
  icon          String   @default("people") @db.VarChar(50)
  coverColor    String   @default("#f7892c") @db.VarChar(20)
  currency      String   @default("INR") @db.VarChar(10)
  monthlyBudget Decimal? @db.Decimal(15, 2)
  monthlyIncome Decimal? @db.Decimal(15, 2)
  totalSpent    Decimal? @default(0) @db.Decimal(15, 2)

  // ─── Lifecycle state machine ────────────────────────────────
  // ACTIVE → PAUSED → ACTIVE (toggle)
  // ACTIVE → COMPLETED → ARCHIVED → CLOSED (terminal)
  // Any state → CLOSED (admin force-close)
  status          String    @default("ACTIVE") @db.VarChar(20)
  statusChangedAt DateTime?
  statusChangedBy String?   @db.VarChar(36)

  // Timestamps for each terminal state
  completedAt DateTime?
  archivedAt  DateTime?
  closedAt    DateTime?
  pausedAt    DateTime?
  frozenAt    DateTime?

  // Settlement lockdown (prevents new entries when finalized)
  settlementsFinalized Boolean   @default(false)
  finalizedAt          DateTime?

  createdBy String   @db.VarChar(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator                 User                     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members                 SharedGroupMember[]
  expenses                SharedExpense[]
  settlements             Settlement[]
  invites                 GroupInvite[]
  contributionRules       ContributionRule[]
  groupMessages           GroupChatMessage[]
  groupChatReads          GroupChatRead[]
  sharedGoals             SharedGoal[]
  householdBills          HouseholdBill[]
  trip                    TripGroup?
  coupleProfile           CoupleFinanceProfile?
  lifecycleEvents         GroupLifecycleEvent[]
  memberRemovalLogs       MemberRemovalLog[]
  reimbursementLogs       ReimbursementLog[]
  coupleFinanceInvites    CoupleFinanceInvite[]
  wallets                 GroupWallet[]
  advanceContributions    AdvanceContribution[]
  expenseApprovals        ExpenseApproval[]
  documents               GroupDocument[]
  calendar                GroupCalendar?
  creditCardBills         CreditCardBill[]
  cashPools               CashPool[]
  emergencyFunds          EmergencyFund[]
  netWorthSnapshots       FamilyNetWorthSnapshot[]
  exports                 ExportHistory[]
  guestMembers            GuestMember[]
  settlementConfirmations SettlementConfirmation[]
  expenseApprovalQueue    ExpenseApprovalQueue[]
  activities              GroupActivity[]
  payNowLinks             PayNowLink[]
  tempInvites             TempInvite[]
  coupleIncomes           CoupleFinanceIncome[]
  coupleSavings           CoupleFinanceSaving[]
  budgetCategories        CoupleBudgetCategory[]
  groupSetting            GroupSetting?

  @@index([createdBy])
  @@index([type])
  @@index([status])
  @@map("shared_groups")
}

model SharedGroupMember {
  id      String @id @default(uuid()) @db.VarChar(36)
  groupId String @db.VarChar(36)
  userId  String @db.VarChar(36)
  role    String @default("member") @db.VarChar(20) // admin, member, viewer

  // Member lifecycle: active, removed, left, expired
  isActive      Boolean   @default(true)
