model TempUser {
  id              String    @id @default(uuid()) @db.VarChar(36)
  email           String?   @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  googleId        String?   @db.VarChar(255)
  displayName     String?   @db.VarChar(255)
  avatarUrl       String?   @db.VarChar(500)
  deviceId        String?   @db.VarChar(255)
  devicePlatform  String?   @db.VarChar(20)    // ios, android, web
  fcmToken        String?   @db.VarChar(500)

  loginMethod     String    @default("anonymous") @db.VarChar(30) // anonymous, google, email_otp, phone_otp, link
  sessionToken    String?   @unique @db.VarChar(500)
  sessionExpiresAt DateTime?
  refreshToken    String?   @db.VarChar(500)

  // Conversion tracking
  convertedToUserId String? @db.VarChar(36)
  convertedAt      DateTime?
  conversionMethod String?  @db.VarChar(30)    // signup, google_login, email_otp
  conversionData   Json?    @db.Json            // scores, triggers, campaign info

  // Activity & scoring
  totalSettlements Decimal  @default(0) @db.Decimal(15, 2)
  expenseCount     Int      @default(0)
  groupCount       Int      @default(0)
  sessionCount     Int      @default(0)
  engagementScore  Float?   @db.Float           // 0-100 heuristic score
  lastActiveAt     DateTime?
  isActive         Boolean  @default(true)

  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  groupMemberships GroupMemberTemp[]
  inviteLinks      InviteLink[]      @relation("TempUserInvites")
  referrerLinks    ReferralLink[]
  conversionEvents ConversionEvent[]
  installEvents    InstallTracking[]
  onboardingEvents OnboardingEvent[]
  premiumTrials    PremiumTrial[]
  referralHistory  ReferralHistory[]     @relation("ReferrerHistory")
  referredUsers    ReferralHistory[]     @relation("ReferredUser")
  sentActivityEvents GroupActivityEvent[] @relation("ActivitySender")
  readChatMessages   TempUserChatRead[]

  @@index([email])
  @@index([phone])
  @@index([googleId])
  @@index([sessionToken])
  @@index([engagementScore])
  @@index([convertedToUserId])
  @@index([lastActiveAt])
  @@map("temp_users")
}

// ─── EXTERNAL SHARING: INVITE LINKS ────────────────────────
model InviteLink {
  id             String    @id @default(uuid()) @db.VarChar(36)
  groupId        String    @db.VarChar(36)
  createdByUserId String?  @db.VarChar(36)     // Dabbu user who created
  createdByTempUserId String? @db.VarChar(36)  // OR temp user
  token          String    @unique @db.VarChar(64)
  shortCode      String?   @unique @db.VarChar(12)
  qrCodeUrl      String?   @db.VarChar(500)

  // Access control
  maxUses        Int       @default(0)        // 0 = unlimited
  useCount       Int       @default(0)
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  revokedAt DateTime?

  // Permissions for temporary users
  canAddExpenses    Boolean @default(true)
  canSettle         Boolean @default(true)
  canChat           Boolean @default(true)
  canUploadBills    Boolean @default(true)
  canViewHistory    Boolean @default(true)
  canInviteOthers   Boolean @default(false)

  // Deep link data
  deepLinkUrl    String?   @db.VarChar(500)
  utmSource      String?   @db.VarChar(50)
  utmCampaign    String?   @db.VarChar(50)
  utmMedium      String?   @db.VarChar(50)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group          SharedFinanceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByUser  User?              @relation(fields: [createdByUserId], references: [id])
  createdByTempUser TempUser?       @relation("TempUserInvites", fields: [createdByTempUserId], references: [id])
  groupMemberTemps GroupMemberTemp[]

  @@index([token])
  @@index([shortCode])
  @@index([groupId])
  @@index([expiresAt])
  @@index([utmSource, utmCampaign])
  @@map("invite_links")
}

// ─── EXTERNAL SHARING: TEMPORARY GROUP MEMBERS ─────────────
