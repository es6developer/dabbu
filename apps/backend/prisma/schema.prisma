// ─── PHASE 2: ADVANCED SHARED FINANCE ─────────────────────
// Group Wallet System

model GroupWallet {
  id          String   @id @default(uuid()) @db.VarChar(36)
  groupId     String   @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("INR") @db.VarChar(10)
  isLocked    Boolean  @default(false)
  requiresApproval Boolean @default(false)
  createdBy   String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        SharedGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User                 @relation(fields: [createdBy], references: [id])
  transactions GroupWalletTransaction[]
  members      GroupWalletMember[]

  @@index([groupId])
  @@map("group_wallets")
}

model GroupWalletTransaction {
  id          String   @id @default(uuid()) @db.VarChar(36)
  walletId    String   @db.VarChar(36)
  type        String   @db.VarChar(30) // contribute, spend, reimburse, transfer_in, transfer_out, withdrawal
  amount      Decimal  @db.Decimal(15, 2)
  balanceBefore Decimal @db.Decimal(15, 2)
  balanceAfter  Decimal @db.Decimal(15, 2)
  description String?  @db.VarChar(500)
  referenceId String?  @db.VarChar(36) // expenseId, transferWalletId, etc
  performedBy String   @db.VarChar(36)
  status      String   @default("completed") @db.VarChar(20) // pending, approved, rejected, completed, failed
  approvedBy  String?  @db.VarChar(36)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  wallet    GroupWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  performer User        @relation(fields: [performedBy], references: [id])
  approver  User?       @relation("WalletApprover", fields: [approvedBy], references: [id])

  @@index([walletId, createdAt])
  @@map("group_wallet_transactions")
}

model GroupWalletMember {
  id        String  @id @default(uuid()) @db.VarChar(36)
  walletId  String  @db.VarChar(36)
  userId    String  @db.VarChar(36)
  role      String  @default("member") @db.VarChar(20) // admin, member, viewer
  share     Decimal @default(0) @db.Decimal(15, 2)
  joinedAt  DateTime @default(now())

  wallet GroupWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])

  @@unique([walletId, userId])
  @@map("group_wallet_members")
}

