}

// ─── PREMIUM ENTITLEMENTS ──────────────────────────────────
model PremiumEntitlement {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @db.VarChar(36)
  subscriptionId String    @db.VarChar(36)
  featureKey     String    @db.VarChar(100)
  enabled        Boolean   @default(true)
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([userId, featureKey])
  @@index([userId, enabled])
  @@index([subscriptionId])
  @@map("premium_entitlements")
}

// ─── DOCUMENT VAULT ──────────────────────────────────────────
// aadhaar, pan, passport, driving_license, insurance, vehicle_rc, warranty, medical
model UserDocument {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @db.VarChar(36)
  name           String    @db.VarChar(255)
  category       String    @db.VarChar(50)
  fileUrl        String    @db.Text
  encryptedPath  String    @db.Text
  encryptionIv   String    @db.VarChar(64)
  mimeType       String    @db.VarChar(100)
  fileSize       Int       @default(0)
  documentNumber String?   @db.VarChar(100)
  issuedDate     DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  issuer         String?   @db.VarChar(255)
  notes          String?   @db.Text
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, deletedAt])
  @@index([userId, expiryDate])
  @@map("user_documents")
}

// ─── SUPPORT TICKETS ──────────────────────────────────────────
model SupportTicket {
  id           String    @id @default(uuid()) @db.VarChar(36)
  subject      String    @db.VarChar(255)
  message      String    @db.Text
  userId       String?   @db.VarChar(36)
  email        String?   @db.VarChar(255)
  status       String    @default("open") @db.VarChar(20) // open, in_progress, resolved, closed
  priority     String    @default("medium") @db.VarChar(20) // low, medium, high, urgent
  category     String    @default("general") @db.VarChar(50) // general, technical, billing, feature, bug
  assignedToId String?   @db.VarChar(36)
  adminNotes   String?   @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo AdminUser? @relation("AssignedTickets", fields: [assignedToId], references: [id])
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([userId])
  @@map("support_tickets")
}
