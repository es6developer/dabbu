  groupId    String   @db.VarChar(36)
  tokenJti   String?  @db.VarChar(255) // JWT ID for token-specific invalidation
  reason     String?  @db.VarChar(200) // member_removed, group_completed, invite_revoked, group_closed, guest_expired
  revokedAt  DateTime @default(now())
  expiresAt  DateTime // when this revocation record itself expires

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, groupId])
  @@index([tokenJti])
  @@map("session_revocations")
}

