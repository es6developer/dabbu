// ───────────────────────────────────────────────────────────
// DABBU - Complete Database Schema
// MySQL + Prisma ORM
// ───────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "extendedWhereUnique"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USERS ─────────────────────────────────────────────────
// Core user accounts with full profile and preferences
model User {
  id              String    @id @default(uuid()) @db.VarChar(36)
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  avatarUrl       String?   @db.VarChar(500)
  phone           String?   @db.VarChar(20)
  currency        String    @default("USD") @db.VarChar(10)
  timezone        String    @default("UTC") @db.VarChar(50)
  locale          String    @default("en") @db.VarChar(10)
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  role            String    @default("user") @db.VarChar(20)      // user, premium, admin, super_admin

  // OTP & 2FA
  otpCode        String?   @db.VarChar(6)
  otpExpiresAt   DateTime?
  otpPurpose     String?   @db.VarChar(20)                        // email_verification, password_reset, login
  otpAttempts    Int       @default(0)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?  @db.VarChar(255)

  // Brute force protection
  loginAttempts  Int       @default(0)
  lockoutUntil   DateTime?
  isLocked       Boolean   @default(false)
  lastLoginAt    DateTime?
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?

  // App lock / PIN
  appPin         String?   @db.VarChar(255)                       // hashed PIN for app lock
  biometricEnabled Boolean  @default(false)

  // Payment gateway IDs
  stripeCustomerId   String?  @db.VarChar(255)
  razorpayCustomerId String?  @db.VarChar(255)

  // Password history (prevent reuse)
  passwordHistory Json?    @db.Json                               // Array of previous password hashes

  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions           Session[]
  devices            Device[]
  reminders          Reminder[]
  recurringReminders RecurringReminder[]
  subscription       Subscription?
  payments           Payment[]
  invoices           Invoice[]
  familyMemberships  FamilyMember[]
  chatParticipants   ChatParticipant[]
  sentMessages       ChatMessage[]        @relation("MessageSender")
  transactions       Transaction[]
  transactionCategories TransactionCategory[]
  analytics          Analytics[]
  notifications      Notification[]
  notificationLogs   NotificationLog[]
  smsDetections      SmsDetection[]
  settings           Settings?
  quotaTracking      QuotaTracking[]
  auditLogs          AuditLog[]
  accounts           Account[]
  budgets            Budget[]
  bills              Bill[]
  scannedBills       ScannedBill[]
  goals              Goal[]
  investments        Investment[]
  paymentMethods     PaymentMethod[]
  createdTasks       SharedTask[]         @relation("TaskCreator")
  assignedTasks      SharedTask[]         @relation("TaskAssignee")
  createdReminders   SharedReminder[]
  expenseGroups              ExpenseGroup[]
  expenseGroupMemberships    ExpenseGroupMember[]

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ─── SESSIONS ──────────────────────────────────────────────
// User authentication sessions for refresh token management
model Session {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @db.VarChar(36)
  refreshToken String   @db.VarChar(500)
  userAgent   String?   @db.VarChar(500)
  ipAddress   String?   @db.VarChar(45)
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── DEVICES ───────────────────────────────────────────────
// User devices for push notifications and device management
model Device {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @db.VarChar(36)
  deviceId       String    @db.VarChar(255)
  platform       String?   @db.VarChar(50)    // ios, android, web
  pushToken      String?   @db.VarChar(500)
  deviceName     String?   @db.VarChar(255)
  appVersion     String?   @db.VarChar(20)
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([pushToken])
  @@map("devices")
}

// ─── REMINDERS ─────────────────────────────────────────────
// One-time reminders for bills, tasks, or events
model Reminder {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  type        String    @default("general") @db.VarChar(50)  // bill, task, event, general
  remindAt    DateTime
  dueDate     DateTime?
  startDate   DateTime?
  status      String    @default("active") @db.VarChar(20)   // active, completed, cancelled
  priority    String    @default("medium") @db.VarChar(10)   // low, medium, high, urgent
  isSent      Boolean   @default(false)
  sentAt      DateTime?
  isSnoozed   Boolean   @default(false)
  snoozedUntil DateTime?
  isRecurring Boolean   @default(false)
  categoryId  String?   @db.VarChar(36)
  deletedAt   DateTime?
  metadata    Json?     @db.Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  TransactionCategory? @relation(fields: [categoryId], references: [id])
  recurring RecurringReminder[]
  notifications Notification[]

  @@index([userId, remindAt])
  @@index([userId, isSent])
  @@index([remindAt, isSent])
  @@map("reminders")
}

// ─── RECURRING REMINDERS ───────────────────────────────────
// Recurring reminder patterns
model RecurringReminder {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  reminderId      String?  @db.VarChar(36)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  type            String   @default("general") @db.VarChar(50)
  frequency       String   @db.VarChar(20)
  interval        Int      @default(1)
  dayOfMonth      Int?
  daysOfWeek      String?  // JSON array for multi-day patterns
  monthOfYear     Int?
  time            String?  @db.VarChar(5)
  startDate       DateTime
  endDate         DateTime?
  occurrences     Int?     // Max number of occurrences
  count           Int      @default(0)  // How many times it has triggered
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  nextTriggerAt   DateTime?
  metadata        Json?    @db.Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id])

  @@unique([reminderId])
  @@index([userId, isActive])
  @@index([nextTriggerAt, isActive])
  @@map("recurring_reminders")
}

// ─── SUBSCRIPTION PLANS ────────────────────────────────────
// Available subscription tiers and pricing
model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD") @db.VarChar(10)
  interval      String   @db.VarChar(20)  // monthly, yearly
  features      Json     @db.Json
  maxAccounts   Int      @default(3)
  maxCategories Int      @default(20)
  maxBudgets    Int      @default(10)
  maxBills      Int      @default(20)
  maxGoals      Int      @default(10)
  maxInvestments Int     @default(5)
  maxFamilyMembers Int   @default(0)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@index([isDefault])
  @@map("subscription_plans")
}

// ─── SUBSCRIPTIONS ─────────────────────────────────────────
// User subscription assignments
model Subscription {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  planId          String    @db.VarChar(36)
  status          String    @default("active") @db.VarChar(20)  // active, cancelled, expired, trial, past_due
  trialEndsAt     DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt     DateTime?
  cancelAtPeriodEnd Boolean  @default(false)

  // Stripe fields
  stripeSubscriptionId  String?  @db.VarChar(255)
  stripePriceId         String?  @db.VarChar(255)

  // Razorpay fields
  razorpaySubscriptionId String? @db.VarChar(255)
  razorpayPlanId         String? @db.VarChar(255)

  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments   Payment[]
  invoices   Invoice[]

  @@unique([userId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@index([stripeSubscriptionId])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

// ─── PAYMENTS ──────────────────────────────────────────────
// Payment transactions for subscriptions
model Payment {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  subscriptionId  String    @db.VarChar(36)
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @db.VarChar(20)  // pending, completed, failed, refunded, partial_refund
  paymentMethod   String?   @db.VarChar(50)  // card, upi, netbanking, wallet, stripe, razorpay
  gateway         String?   @db.VarChar(20)  // stripe, razorpay

  // Stripe fields
  stripePaymentIntentId    String?  @db.VarChar(255)
  stripePaymentMethodId    String?  @db.VarChar(255)
  stripeChargeId           String?  @db.VarChar(255)

  // Razorpay fields
  razorpayPaymentId        String?  @db.VarChar(255)
  razorpayOrderId          String?  @db.VarChar(255)
  razorpaySignature        String?  @db.VarChar(255)

  receiptUrl      String?   @db.VarChar(500)
  failureMessage  String?   @db.Text
  failureCode     String?   @db.VarChar(100)
  paidAt          DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?  @db.Decimal(10, 2)
  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([stripePaymentIntentId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status, createdAt])
  @@map("payments")
}

// ─── INVOICES ──────────────────────────────────────────────
// Generated invoices for billing
model Invoice {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  subscriptionId  String    @db.VarChar(36)
  invoiceNumber   String    @unique @db.VarChar(50)
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @db.VarChar(20)  // draft, sent, paid, overdue, cancelled
  dueDate         DateTime
  paidAt          DateTime?
  pdfUrl          String?   @db.VarChar(500)
  lineItems       Json      @db.Json
  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([invoiceNumber])
  @@index([dueDate, status])
  @@map("invoices")
}

// ─── FAMILIES ──────────────────────────────────────────────
// Family/group sharing accounts
model Family {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @db.VarChar(255)
  code        String?   @unique @db.VarChar(20)  // Invite code
  ownerId     String    @db.VarChar(36)
  maxMembers  Int       @default(5)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  members   FamilyMember[]
  tasks     SharedTask[]
  reminders SharedReminder[]

  @@index([code])
  @@index([ownerId])
  @@map("families")
}

// ─── FAMILY MEMBERS ────────────────────────────────────────
// Family membership mapping
model FamilyMember {
  id        String   @id @default(uuid()) @db.VarChar(36)
  familyId  String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  role      String   @default("member") @db.VarChar(20)  // owner, admin, member, viewer
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId, role])
  @@index([userId])
  @@map("family_members")
}

// ─── CHATS ─────────────────────────────────────────────────
// Chat/conversation threads
model Chat {
  id         String   @id @default(uuid()) @db.VarChar(36)
  title      String?  @db.VarChar(255)
  type       String   @default("direct") @db.VarChar(20)  // direct, group, family
  createdBy  String   @db.VarChar(36)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  messages ChatMessage[]
  participants ChatParticipant[]

  @@index([createdBy])
  @@index([type])
  @@map("chats")
}

// ─── CHAT PARTICIPANTS ─────────────────────────────────────
model ChatParticipant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  chatId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, isActive])
  @@map("chat_participants")
}

// ─── CHAT MESSAGES ─────────────────────────────────────────
// Individual messages within chats
model ChatMessage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  chatId    String   @db.VarChar(36)
  senderId  String   @db.VarChar(36)
  content   String   @db.Text
  messageType String @default("text") @db.VarChar(20)  // text, image, file, system
  mediaUrl  String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  readAt    DateTime?
  isEdited  Boolean  @default(false)
  editedAt  DateTime?
  replyToId String?  @db.VarChar(36)
  metadata  Json?    @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chat     Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender   User        @relation("MessageSender", fields: [senderId], references: [id])
  replyTo  ChatMessage? @relation("MessageReply", fields: [replyToId], references: [id])
  replies  ChatMessage[] @relation("MessageReply")

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId, isRead])
  @@index([messageType])
  @@map("chat_messages")
}

// ─── SHARED TASKS ──────────────────────────────────────────
// Tasks shared within families/groups
model SharedTask {
  id          String    @id @default(uuid()) @db.VarChar(36)
  familyId    String    @db.VarChar(36)
  createdById String    @db.VarChar(36)
  assignedToId String?  @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(20)  // pending, in_progress, completed, cancelled
  priority    String    @default("medium") @db.VarChar(10)   // low, medium, high, urgent
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  completedById String? @db.VarChar(36)
  isRecurring Boolean   @default(false)
  frequency   String?   @db.VarChar(20)
  metadata    Json?     @db.Json
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([familyId, status])
  @@index([assignedToId, status])
  @@index([dueDate, status])
  @@map("shared_tasks")
}

// ─── SHARED REMINDERS ─────────────────────────────────────
// Reminders shared within families
model SharedReminder {
  id          String    @id @default(uuid()) @db.VarChar(36)
  familyId    String    @db.VarChar(36)
  createdById String    @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  remindAt    DateTime
  isSent      Boolean   @default(false)
  isRecurring Boolean   @default(false)
  frequency   String?   @db.VarChar(20)
  metadata    Json?     @db.Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([familyId, remindAt])
  @@index([familyId, isSent])
  @@map("shared_reminders")
}

// ─── ACCOUNTS ──────────────────────────────────────────────
// Financial accounts (bank, credit card, cash, investment, etc.)
model Account {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(20)   // checking, savings, credit_card, cash, investment, loan, wallet
  currency        String   @default("USD") @db.VarChar(10)
  balance         Decimal  @default(0) @db.Decimal(15, 2)
  initialBalance  Decimal  @default(0) @db.Decimal(15, 2)
  creditLimit     Decimal? @db.Decimal(15, 2)
  color           String?  @db.VarChar(50)
  icon            String?  @db.VarChar(50)
  isActive        Boolean  @default(true)
  isArchived      Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  lastSyncedAt    DateTime?
  description     String?  @db.VarChar(500)
  institution     String?  @db.VarChar(255)
  lastFourDigits  String?  @db.VarChar(4)
  sortOrder       Int      @default(0)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  investments  Investment[]

  @@index([userId, isActive])
  @@index([userId, type])
  @@index([userId, isArchived])
  @@map("accounts")
}

// ─── TRANSACTION CATEGORIES ────────────────────────────────
// Hierarchical transaction categories
model TransactionCategory {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  name            String    @db.VarChar(100)
  transactionType String    @db.VarChar(10)   // income, expense
  icon            String?   @db.VarChar(50)
  color           String?   @db.VarChar(50)
  parentId        String?   @db.VarChar(36)
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       TransactionCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     TransactionCategory[] @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  bills        Bill[]
  reminders    Reminder[]

  @@index([userId, transactionType])
  @@index([userId, parentId])
  @@index([userId, isActive])
  @@index([name, userId])
  @@map("transaction_categories")
}

// ─── TRANSACTIONS ──────────────────────────────────────────
// Core financial transactions (income, expense, transfers)
model Transaction {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  userId             String    @db.VarChar(36)
  accountId          String?   @db.VarChar(36)
  categoryId         String?   @db.VarChar(36)
  amount             Decimal   @db.Decimal(15, 2)
  type               String    @db.VarChar(10)    // income, expense, transfer
  status             String    @default("completed") @db.VarChar(20)  // completed, pending, cancelled
  date               DateTime  @db.Date
  description        String?   @db.VarChar(500)
  notes              String?   @db.Text
  tags               Json?     @db.Json
  isRecurring        Boolean   @default(false)
  recurringId        String?   @db.VarChar(36)
  recurringFrequency String?   @db.VarChar(20)
  recurringEndDate   DateTime? @db.Date
  receiptUrl         String?   @db.VarChar(500)
  exchangeRate       Decimal?  @db.Decimal(10, 6)
  originalCurrency   String?   @db.VarChar(10)
  originalAmount     Decimal?  @db.Decimal(15, 2)
  transferToAccountId String?  @db.VarChar(36)
  isReviewed         Boolean   @default(false)
  isSplit            Boolean   @default(false)
  parentTransactionId String?  @db.VarChar(36)
  expenseGroupId     String?   @db.VarChar(36)
  metadata           Json?     @db.Json
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?            @relation(fields: [accountId], references: [id])
  category      TransactionCategory? @relation(fields: [categoryId], references: [id])
  expenseGroup  ExpenseGroup?       @relation(fields: [expenseGroupId], references: [id])
  splitTransactions Transaction[]   @relation("SplitTransaction")
  parentTransaction Transaction?    @relation("SplitTransaction", fields: [parentTransactionId], references: [id])

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([userId, type, date])
  @@index([userId, status])
  @@index([userId, isReviewed])
  @@index([expenseGroupId, date])
  @@index([date, status])
  @@map("transactions")
}

// ─── BUDGETS ───────────────────────────────────────────────
// Budget tracking by category and time period
model Budget {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @db.VarChar(36)
  categoryId String?   @db.VarChar(36)
  name       String    @db.VarChar(255)
  amount     Decimal   @db.Decimal(15, 2)
  spent      Decimal   @default(0) @db.Decimal(15, 2)
  period     String    @default("monthly") @db.VarChar(15)  // monthly, yearly, custom
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  isActive   Boolean   @default(true)
  notifyAt   Int       @default(80)  // Percentage threshold for notification
  notes      String?   @db.VarChar(500)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory? @relation(fields: [categoryId], references: [id])

  @@index([userId, isActive])
  @@index([userId, period])
  @@index([userId, startDate, endDate])
  @@index([categoryId, startDate, endDate])
  @@map("budgets")
}

// ─── BILLS ─────────────────────────────────────────────────
// Bill tracking and payment reminders
model Bill {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  accountId    String?   @db.VarChar(36)
  categoryId   String?   @db.VarChar(36)
  name         String    @db.VarChar(255)
  amount       Decimal   @db.Decimal(15, 2)
  dueDate      DateTime  @db.Date
  isPaid       Boolean   @default(false)
  paidDate     DateTime? @db.Date
  isRecurring  Boolean   @default(false)
  frequency    String?   @db.VarChar(20)
  reminderDays Int       @default(5)
  notes        String?   @db.VarChar(500)
  payee        String?   @db.VarChar(255)
  autopayUrl   String?   @db.VarChar(500)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?            @relation(fields: [accountId], references: [id])
  category TransactionCategory? @relation(fields: [categoryId], references: [id])

  @@index([userId, dueDate])
  @@index([userId, isPaid])
  @@index([dueDate, isPaid])
  @@map("bills")
}

// ─── GOALS ─────────────────────────────────────────────────
// Financial goals with progress tracking
model Goal {
  id            String    @id @default(uuid()) @db.VarChar(36)
  userId        String    @db.VarChar(36)
  accountId     String?   @db.VarChar(36)
  name          String    @db.VarChar(255)
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime? @db.Date
  type          String    @default("savings") @db.VarChar(20)  // savings, investment, debt, custom
  icon          String?   @db.VarChar(50)
  color         String?   @db.VarChar(50)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime? @db.Date
  sortOrder     Int?      @default(0)
  notes         String?   @db.VarChar(500)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@index([userId, deadline])
  @@index([userId, type])
  @@map("goals")
}

// ─── INVESTMENTS ───────────────────────────────────────────
// Investment portfolio tracking
model Investment {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  accountId    String?   @db.VarChar(36)
  name         String    @db.VarChar(255)
  type         String    @db.VarChar(20)    // stock, crypto, mutual_fund, etf, bond, real_estate, other
  symbol       String?   @db.VarChar(20)
  quantity     Decimal   @db.Decimal(15, 6)
  buyPrice     Decimal   @db.Decimal(15, 2)
  currentPrice Decimal?  @db.Decimal(15, 2)
  purchaseDate DateTime? @db.Date
  fees         Decimal?  @db.Decimal(15, 2)
  currency     String    @default("USD") @db.VarChar(10)
  notes        String?   @db.VarChar(500)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([userId, type])
  @@index([userId, symbol])
  @@map("investments")
}

// ─── ANALYTICS ─────────────────────────────────────────────
// Pre-computed analytics for performance
model Analytics {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @db.VarChar(36)
  period         String   @db.VarChar(15)   // daily, weekly, monthly, yearly
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  totalIncome    Decimal  @default(0) @db.Decimal(15, 2)
  totalExpense   Decimal  @default(0) @db.Decimal(15, 2)
  netAmount      Decimal  @default(0) @db.Decimal(15, 2)
  totalAccountsBalance Decimal @default(0) @db.Decimal(15, 2)
  topCategory    String?  @db.VarChar(100)
  transactionCount Int    @default(0)
  metadata       Json?    @db.Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodStart])
  @@index([userId, period, periodStart])
  @@index([userId, periodStart, periodEnd])
  @@map("analytics")
}

// ─── NOTIFICATIONS ─────────────────────────────────────────
// User notifications (in-app and push)
model Notification {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  type      String    @db.VarChar(50)   // bill_reminder, budget_alert, goal_milestone, large_transaction, weekly_report, monthly_report, account_alert, reminder_upcoming, reminder_overdue
  title     String    @db.VarChar(255)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  actionUrl String?   @db.VarChar(500)
  data      Json?     @db.Json
  createdAt DateTime  @default(now())

  // Smart reminder notification fields
  reminderId  String?   @db.VarChar(36)
  billId      String?   @db.VarChar(36)
  priority    String    @default("medium") @db.VarChar(10)   // low, medium, high, urgent
  category    String?   @db.VarChar(50)                       // bill, subscription, payment, task, event, goal
  overdue     Boolean   @default(false)
  snoozedUntil DateTime?

  // Relations
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  NotificationLog[]
  reminder Reminder?        @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, priority])
  @@index([reminderId])
  @@index([isRead, createdAt])
  @@index([overdue])
  @@map("notifications")
}

// ─── NOTIFICATION LOGS ─────────────────────────────────────
// Notification delivery logs
model NotificationLog {
  id             String    @id @default(uuid()) @db.VarChar(36)
  notificationId String    @db.VarChar(36)
  userId         String    @db.VarChar(36)
  channel        String    @db.VarChar(20)    // push, email, sms, in_app
  status         String    @db.VarChar(20)    // sent, delivered, failed, opened
  errorMessage   String?   @db.Text
  deliveredAt    DateTime?
  openedAt       DateTime?
  metadata       Json?     @db.Json
  createdAt      DateTime  @default(now())

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId, status])
  @@index([channel, createdAt])
  @@map("notification_logs")
}

// ─── SMS DETECTIONS ────────────────────────────────────────
// SMS-based transaction detection (auto-categorization)
model SmsDetection {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @db.VarChar(36)
  sender         String    @db.VarChar(255)
  messageBody    String    @db.Text
  detectedAmount Decimal?  @db.Decimal(15, 2)
  detectedCurrency String? @db.VarChar(10)
  detectedType   String?   @db.VarChar(10)    // income, expense
  confidence     Float?    @db.Float
  categoryId     String?   @db.VarChar(36)
  isProcessed    Boolean   @default(false)
  processedAt    DateTime?
  transactionId  String?   @db.VarChar(36)
  rawData        Json?     @db.Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isProcessed])
  @@index([sender])
  @@index([createdAt])
  @@map("sms_detections")
}

// ─── SETTINGS ──────────────────────────────────────────────
// User application settings
model Settings {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  userId                String   @unique @db.VarChar(36)
  theme                 String   @default("system") @db.VarChar(10)   // light, dark, system
  weeklyReport          Boolean  @default(true)
  monthlyReport         Boolean  @default(true)
  largeTransactionAlert Decimal  @default(1000) @db.Decimal(15, 2)
  budgetAlertThreshold  Int      @default(80)   // percentage
  pushNotifications     Boolean  @default(true)
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  biometricAuth         Boolean  @default(false)
  autoDetectTransactions Boolean @default(true)
  defaultCurrency       String   @default("USD") @db.VarChar(10)
  dateFormat            String   @default("MM/dd/yyyy") @db.VarChar(20)
  firstDayOfWeek        Int      @default(0)     // 0=Sunday, 1=Monday
  language              String   @default("en") @db.VarChar(10)
  metadata              Json?    @db.Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ─── FEATURE FLAGS ─────────────────────────────────────────
// Feature flags for gradual rollout
model FeatureFlag {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isEnabled   Boolean  @default(false)
  rollouts    Json?    @db.Json     // { "percentage": 50, "userIds": [...], "plans": [...] }
  createdBy   String?  @db.VarChar(36)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([isEnabled])
  @@map("feature_flags")
}

// ─── WEBHOOK EVENTS ────────────────────────────────────────
// Incoming webhook events from payment gateways
model WebhookEvent {
  id            String   @id @default(uuid()) @db.VarChar(36)
  gateway       String   @db.VarChar(20)               // stripe, razorpay
  eventId       String   @db.VarChar(255)               // Gateway's event ID
  eventType     String   @db.VarChar(100)               // e.g., invoice.paid, payment_intent.succeeded
  status        String   @default("pending") @db.VarChar(20)  // pending, processed, failed
  requestBody   Json     @db.Json
  responseStatus Int?    @default(200)
  errorMessage  String?  @db.Text
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([gateway, status])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
  @@map("webhook_events")
}

// ─── PAYMENT METHODS ───────────────────────────────────────
// Saved payment methods for users
model PaymentMethod {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  gateway         String    @db.VarChar(20)               // stripe, razorpay
  type            String    @db.VarChar(20)               // card, upi, netbanking, wallet
  isDefault       Boolean   @default(false)

  // Stripe fields
  stripePaymentMethodId String? @db.VarChar(255)

  // Razorpay fields
  razorpayInstrumentId  String? @db.VarChar(255)
  razorpayTokenId       String? @db.VarChar(255)

  // Card details (masked)
  lastFourDigits  String?   @db.VarChar(4)
  cardBrand       String?   @db.VarChar(20)              // visa, mastercard, amex, rupay
  expMonth        Int?
  expYear         Int?
  cardHolderName  String?   @db.VarChar(255)

  // UPI details
  upiHandle       String?   @db.VarChar(100)

  // Bank details
  bankName        String?   @db.VarChar(100)

  isExpired       Boolean   @default(false)
  billingAddress  Json?     @db.Json
  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([userId, gateway])
  @@index([stripePaymentMethodId])
  @@index([razorpayInstrumentId])
  @@map("payment_methods")
}

// ─── QUOTA TRACKING ────────────────────────────────────────
// Usage quota tracking per user
model QuotaTracking {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @db.VarChar(36)
  resource    String   @db.VarChar(50)   // accounts, categories, budgets, bills, goals, investments, family_members
  used        Int      @default(0)
  limit       Int      @default(0)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, periodStart])
  @@index([userId, resource])
  @@index([resource, periodStart, periodEnd])
  @@map("quota_tracking")
}

// ─── ADMIN USERS ───────────────────────────────────────────
// Administrative users with elevated privileges
model AdminUser {
  id        String    @id @default(uuid()) @db.VarChar(36)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  name      String    @db.VarChar(255)
  role      String    @default("admin") @db.VarChar(20)  // super_admin, admin, support, analyst
  permissions Json   @db.Json
  isActive  Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@map("admin_users")
}

// ─── AUDIT LOGS ────────────────────────────────────────────
// Comprehensive audit trail for compliance
model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @db.VarChar(36)
  adminId     String?  @db.VarChar(36)
  action      String   @db.VarChar(100)   // created, updated, deleted, viewed, exported, login, logout
  entity      String   @db.VarChar(50)    // user, account, transaction, budget, bill, goal, investment, subscription, settings
  entityId    String?  @db.VarChar(36)
  description String?  @db.Text
  oldValues   Json?    @db.Json
  newValues   Json?    @db.Json
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  // Relations
  user  User?      @relation(fields: [userId], references: [id])
  admin AdminUser? @relation(fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── SCANNED BILLS ──────────────────────────────────────────
// Stores analyzed bills from receipt scanning
model ScannedBill {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @db.VarChar(36)
  merchantName String?  @db.VarChar(255)
  category     String?  @db.VarChar(100)
  totalAmount  Decimal? @db.Decimal(12, 2)
  currency     String   @default("INR") @db.VarChar(10)
  billDate     DateTime?
  items        Json?    @db.Json
  notes        String?  @db.Text
  imageUrl     String?  @db.Text
  confidence   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, billDate])
  @@index([userId, category])
  @@map("scanned_bills")
}

// ─── EXPENSE GROUPS (Expenses tab, NOT split groups) ──────
model ExpenseGroup {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  icon          String   @default("users") @db.VarChar(50)
  currency      String   @default("INR") @db.VarChar(10)
  monthlyBudget Decimal? @db.Decimal(15, 2)
  monthlyIncome Decimal? @db.Decimal(15, 2)
  createdBy     String   @db.VarChar(36)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members      ExpenseGroupMember[]
  transactions Transaction[]

  @@index([createdBy])
  @@map("expense_groups")
}

model ExpenseGroupMember {
  id         String   @id @default(uuid()) @db.VarChar(36)
  groupId    String   @db.VarChar(36)
  userId     String   @db.VarChar(36)
  role       String   @default("member") @db.VarChar(20) // admin, member
  addedAt    DateTime @default(now())

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("expense_group_members")
}

// ─── CURRENCIES ─────────────────────────────────────────────
model Currency {
  id       String   @id @default(uuid()) @db.VarChar(36)
  code     String   @unique @db.VarChar(3)
  name     String   @db.VarChar(100)
  symbol   String   @db.VarChar(10)
  locale   String?  @db.VarChar(10)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

