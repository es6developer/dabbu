  @@index([groupId, type])
  @@index([expiresAt])
  @@map("group_documents")
}

model DocumentPermission {
  id         String  @id @default(uuid()) @db.VarChar(36)
  documentId String  @db.VarChar(36)
  userId     String  @db.VarChar(36)
  canView    Boolean @default(true)
  canDownload Boolean @default(false)
  canShare   Boolean @default(false)
  canDelete  Boolean @default(false)
  grantedAt  DateTime @default(now())

  document GroupDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@map("document_permissions")
}

model DocumentAuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  documentId String   @db.VarChar(36)
  action     String   @db.VarChar(50) // view, download, share, delete, archive, ocr
  performedBy String  @db.VarChar(36)
  metadata   Json?    @db.Json
  createdAt  DateTime @default(now())

  document GroupDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performer User         @relation(fields: [performedBy], references: [id])

  @@index([documentId, createdAt])
  @@map("document_audit_logs")
}

// ─── Group Calendar ───────────────────────────────────────

model GroupCalendar {
  id      String   @id @default(uuid()) @db.VarChar(36)
  groupId String   @unique @db.VarChar(36)
  name    String   @default("Group Calendar") @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  SharedGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@map("group_calendars")
}

model CalendarEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  calendarId  String   @db.VarChar(36)
  title       String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  eventType   String   @default("custom") @db.VarChar(30) // trip, due_date, birthday, anniversary, bill, reminder, custom
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  color       String?  @db.VarChar(20)
  recurrence  String?  @db.VarChar(50) // daily, weekly, monthly, yearly, none
  referenceId String?  @db.VarChar(36) // expenseId, billId, etc
  createdBy   String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar GroupCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator  User          @relation(fields: [createdBy], references: [id])

  @@index([calendarId, startDate])
  @@map("calendar_events")
}

// ─── Split Templates ──────────────────────────────────────

model SplitTemplate {
  id             String   @id @default(uuid()) @db.VarChar(36)
  name           String   @db.VarChar(255)
  description    String?  @db.VarChar(500)
  groupType      String   @default("friends") @db.VarChar(50)
  icon           String   @default("documents") @db.VarChar(50)
  coverColor     String   @default("#f7892c") @db.VarChar(20)
  currency       String   @default("INR") @db.VarChar(10)
  defaultBudget  Decimal? @db.Decimal(15, 2)
  usageCount     Int      @default(0)
  isPremium      Boolean  @default(false)
  isOfficial     Boolean  @default(false)
  createdBy      String?  @db.VarChar(36)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator            User?                       @relation(fields: [createdBy], references: [id])
  categories         TemplateCategory[]
  contributionRules  TemplateContributionRule[]

  @@index([groupType])
  @@index([usageCount])
  @@map("split_templates")
}

model TemplateCategory {
  id          String  @id @default(uuid()) @db.VarChar(36)
  templateId  String  @db.VarChar(36)
  name        String  @db.VarChar(100)
  icon        String  @default("card") @db.VarChar(50)
  defaultAmount Decimal? @db.Decimal(15, 2)

  template SplitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_categories")
}

model TemplateContributionRule {
  id         String  @id @default(uuid()) @db.VarChar(36)
  templateId String  @db.VarChar(36)
  name       String  @db.VarChar(100)
  type       String  @default("equal") @db.VarChar(30)
  values     Json    @db.Json
  frequency  String  @default("one_time") @db.VarChar(20)
  autoApply  Boolean @default(false)

  template SplitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_contribution_rules")
}

// ─── Credit Card Bill Split ───────────────────────────────

model CreditCardBill {
  id            String   @id @default(uuid()) @db.VarChar(36)
  groupId       String   @db.VarChar(36)
  uploadedBy    String   @db.VarChar(36)
  cardHolder    String   @db.VarChar(255)
  cardType      String?  @db.VarChar(50)
  lastFour      String?  @db.VarChar(4)
  statementDate DateTime?
  dueDate       DateTime?
  totalAmount   Decimal  @db.Decimal(15, 2)
  currency      String   @default("INR") @db.VarChar(10)
  fileUrl       String?  @db.Text
  ocrText       String?  @db.Text
  status        String   @default("pending") @db.VarChar(20) // pending, parsed, partially_split, fully_split
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group        SharedGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader     User               @relation(fields: [uploadedBy], references: [id])
  transactions CreditCardTransaction[]
  splits       BillSplit[]

  @@index([groupId, status])
  @@map("credit_card_bills")
}

model CreditCardTransaction {
  id          String   @id @default(uuid()) @db.VarChar(36)
  billId      String   @db.VarChar(36)
  date        DateTime
  description String   @db.VarChar(500)
  amount      Decimal  @db.Decimal(15, 2)
  category    String?  @db.VarChar(100)
  merchant    String?  @db.VarChar(255)
  isSplit     Boolean  @default(false)
  createdAt   DateTime @default(now())

  bill   CreditCardBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  splits BillSplit[]

  @@index([billId])
  @@map("credit_card_transactions")
}

model BillSplit {
  id             String   @id @default(uuid()) @db.VarChar(36)
  billId         String   @db.VarChar(36)
  transactionId  String   @db.VarChar(36)
  userId         String   @db.VarChar(36)
  amount         Decimal  @db.Decimal(15, 2)
  note           String?  @db.VarChar(500)
  isPaid         Boolean  @default(false)
  createdAt      DateTime @default(now())

  bill        CreditCardBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  transaction CreditCardTransaction @relation(fields: [transactionId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
  @@map("bill_splits")
}

// ─── Cash Pool ────────────────────────────────────────────

model CashPool {
  id          String   @id @default(uuid()) @db.VarChar(36)
  groupId     String   @db.VarChar(36)
  name        String   @default("Cash Pool") @db.VarChar(255)
  totalCash   Decimal  @default(0) @db.Decimal(15, 2)
  remaining   Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("INR") @db.VarChar(10)
  custodian   String   @db.VarChar(36)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       SharedGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  custodianRel User           @relation(fields: [custodian], references: [id])
  transactions CashTransaction[]

  @@index([groupId, isActive])
  @@map("cash_pools")
}

model CashTransaction {
  id         String   @id @default(uuid()) @db.VarChar(36)
  poolId     String   @db.VarChar(36)
  type       String   @db.VarChar(20) // deposit, spend, reconciliation
  amount     Decimal  @db.Decimal(15, 2)
  description String? @db.VarChar(500)
  category   String?  @db.VarChar(50)
  performedBy String  @db.VarChar(36)
  balanceBefore Decimal @db.Decimal(15, 2)
  balanceAfter  Decimal @db.Decimal(15, 2)
  createdAt  DateTime @default(now())

  pool      CashPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  performer User        @relation(fields: [performedBy], references: [id])

  @@index([poolId, createdAt])
  @@map("cash_transactions")
}

// ─── Emergency Fund ───────────────────────────────────────

model EmergencyFund {
  id          String   @id @default(uuid()) @db.VarChar(36)
  groupId     String   @db.VarChar(36)
  name        String   @default("Emergency Fund") @db.VarChar(255)
  targetAmount Decimal @db.Decimal(15, 2)
  savedAmount Decimal  @default(0) @db.Decimal(15, 2)
  monthlyContribution Decimal @default(0) @db.Decimal(15, 2)
  currency    String   @default("INR") @db.VarChar(10)
  isActive    Boolean  @default(true)
  createdBy   String   @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group         SharedGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User                   @relation(fields: [createdBy], references: [id])
  contributions EmergencyContribution[]
  withdrawals   EmergencyWithdrawal[]

  @@index([groupId, isActive])
  @@map("emergency_funds")
}

model EmergencyContribution {
  id        String   @id @default(uuid()) @db.VarChar(36)
  fundId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  amount    Decimal  @db.Decimal(15, 2)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  fund EmergencyFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@index([fundId])
  @@map("emergency_contributions")
}

model EmergencyWithdrawal {
  id          String   @id @default(uuid()) @db.VarChar(36)
  fundId      String   @db.VarChar(36)
  withdrawnBy String   @db.VarChar(36)
  amount      Decimal  @db.Decimal(15, 2)
  reason      String   @db.VarChar(500)
  approvedBy  String?  @db.VarChar(36)
  status      String   @default("pending") @db.VarChar(20) // pending, approved, rejected
  createdAt   DateTime @default(now())
  approvedAt  DateTime?

  fund      EmergencyFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  withdrawer User         @relation(fields: [withdrawnBy], references: [id])
  approver   User?        @relation("WithdrawalApprover", fields: [approvedBy], references: [id])

  @@index([fundId, status])
  @@map("emergency_withdrawals")
}

// ─── Gamification & Achievements ──────────────────────────

model Badge {
  id          String   @id @default(uuid()) @db.VarChar(36)
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  icon        String   @default("trophy") @db.VarChar(50)
  category    String   @default("general") @db.VarChar(30) // settlement, expense, savings, streak, social, premium
  tier        String   @default("bronze") @db.VarChar(20) // bronze, silver, gold, platinum
  criteria    Json     @db.Json // { type: 'expense_count', threshold: 100 }
  rewardPremiumDays Int @default(0)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@index([category, tier])
  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  badgeId   String   @db.VarChar(36)
  progress  Decimal  @default(0) @db.Decimal(15, 2)
  isEarned  Boolean  @default(false)
  earnedAt  DateTime?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Referral Program ─────────────────────────────────────

model ReferralProgram {
  id          String   @id @default(uuid()) @db.VarChar(36)
  referrerId  String   @db.VarChar(36)
  refereeEmail String  @db.VarChar(255)
  refereeId   String?  @db.VarChar(36)
  code        String   @unique @db.VarChar(50)
  status      String   @default("pending") @db.VarChar(20) // pending, signed_up, converted, expired
  rewardDays  Int      @default(30)
  rewardClaimed Boolean @default(false)
  rewardClaimedAt DateTime?
  createdAt   DateTime @default(now())
  convertedAt DateTime?

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User? @relation("ReferredUser", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referral_programs")
}

// ─── Family Net Worth ─────────────────────────────────────

model FamilyNetWorthSnapshot {
  id          String   @id @default(uuid()) @db.VarChar(36)
  groupId     String   @db.VarChar(36)
  totalAssets Decimal  @db.Decimal(15, 2)
  totalLiabilities Decimal @db.Decimal(15, 2)
  netWorth    Decimal  @db.Decimal(15, 2)
  savingsRatio Decimal  @db.Decimal(5, 2)
  snapshotDate DateTime @default(now())
  createdAt   DateTime @default(now())

  group  SharedGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items  NetWorthItem[]

  @@index([groupId, snapshotDate])
  @@map("family_net_worth_snapshots")
}

model NetWorthItem {
  id         String @id @default(uuid()) @db.VarChar(36)
  snapshotId String @db.VarChar(36)
  type       String @db.VarChar(30) // bank, investment, loan, emi, asset, liability, property, vehicle, gold, other
  name       String @db.VarChar(255)
  amount     Decimal @db.Decimal(15, 2)
  category   String @db.VarChar(20) // asset or liability

  snapshot FamilyNetWorthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, type])
  @@map("net_worth_items")
}

// ─── Export History ───────────────────────────────────────

model ExportHistory {
  id         String   @id @default(uuid()) @db.VarChar(36)
  groupId    String   @db.VarChar(36)
  exportedBy String   @db.VarChar(36)
  exportType String   @db.VarChar(30) // pdf, excel, csv
  reportType String   @db.VarChar(30) // trip, settlement, contribution, yearly, full
  fileUrl    String?  @db.Text
  fileSize   Int      @default(0)
  status     String   @default("completed") @db.VarChar(20)
  createdAt  DateTime @default(now())

  group    SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exporter User        @relation(fields: [exportedBy], references: [id])

  @@index([groupId, createdAt])
  @@map("export_history")
}

// ─── Premium Conversion Tracking ──────────────────────────

model PremiumConversionEvent {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  trigger    String   @db.VarChar(50) // large_group, multiple_wallets, ocr_usage, family_analytics, export_usage, referral
  metadata   Json?    @db.Json
  bannerShown Boolean @default(false)
  bannerDismissed Boolean @default(false)
  trialStarted Boolean @default(false)
  trialStartedAt DateTime?
  convertedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, trigger])
  @@map("premium_conversion_events")
}
