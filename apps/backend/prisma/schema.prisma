  // Profile
  name      String  @db.VarChar(255)
  phone     String? @db.VarChar(20)
  email     String? @db.VarChar(255)
  avatarUrl String? @db.VarChar(500)

  // Payment details
  upiId                String? @db.VarChar(100)
  settlementPreference String  @default("upi") @db.VarChar(20) // upi, cash, bank, other

  // Invite tracking
  inviteToken  String?   @unique @db.VarChar(255)
  inviteStatus String    @default("pending") @db.VarChar(20) // pending, accepted, expired, revoked
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  expiresAt    DateTime

  // Settlement status
  totalOwed Decimal @default(0) @db.Decimal(15, 2)
  totalPaid Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([inviteToken])
  @@index([phone])
  @@map("guest_members")
}

// ─── SETTLEMENT CONFIRMATION ──────────────────────────────
// Tracks payer confirmations and receiver confirmations
model SettlementConfirmation {
  id           String @id @default(uuid()) @db.VarChar(36)
  settlementId String @unique @db.VarChar(36)
  groupId      String @db.VarChar(36)

  // Payer confirms they sent payment
  payerConfirmed   Boolean   @default(false)
  payerConfirmedAt DateTime?
  payerNote        String?   @db.VarChar(500)

  // Receiver confirms they received payment
  receiverConfirmed   Boolean   @default(false)
  receiverConfirmedAt DateTime?
  receiverNote        String?   @db.VarChar(500)
  receiverRejected    Boolean   @default(false)
  rejectionReason     String?   @db.VarChar(500)

  // UPI payment tracking
  upiTransactionId String? @db.VarChar(255)
  upiDeepLink      String? @db.VarChar(500)
  paymentMethod    String? @db.VarChar(30) // gpay, phonepay, paytm, bhim, other

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlement Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  group      SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([groupId])
  @@map("settlement_confirmations")
}

