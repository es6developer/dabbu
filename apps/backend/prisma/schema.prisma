// ───────────────────────────────────────────────────────────
// DABBU - Complete Database Schema
// MySQL + Prisma ORM
// ───────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "extendedWhereUnique"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USERS ─────────────────────────────────────────────────
// Core user accounts with full profile and preferences
model User {
  id              String    @id @default(uuid()) @db.VarChar(36)
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  avatarUrl       String?   @db.VarChar(500)
  phone           String?   @db.VarChar(20)
  currency        String    @default("USD") @db.VarChar(10)
  timezone        String    @default("UTC") @db.VarChar(50)
  locale          String    @default("en") @db.VarChar(10)
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  role            String    @default("user") @db.VarChar(20)      // user, premium, admin, super_admin

  // OTP & 2FA
  otpCode        String?   @db.VarChar(6)
  otpExpiresAt   DateTime?
  otpPurpose     String?   @db.VarChar(20)                        // email_verification, password_reset, login
  otpAttempts    Int       @default(0)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?  @db.VarChar(255)

  // Brute force protection
  loginAttempts  Int       @default(0)
  lockoutUntil   DateTime?
  isLocked       Boolean   @default(false)
  lastLoginAt    DateTime?
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?

  // App lock / PIN
  appPin         String?   @db.VarChar(255)                       // hashed PIN for app lock
  biometricEnabled Boolean  @default(false)

  // Payment gateway IDs
  stripeCustomerId   String?  @db.VarChar(255)
  razorpayCustomerId String?  @db.VarChar(255)

  // Password history (prevent reuse)
  passwordHistory Json?    @db.Json                               // Array of previous password hashes

  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Shadow / temporary user support
  status         String   @default("active") @db.VarChar(20)    // active, temporary, merged
  authProvider   String   @default("email") @db.VarChar(20)     // email, google, apple
  tempGroupId    String?  @db.VarChar(36)                       // group scoped to for temp users
  mergedIntoId   String?  @db.VarChar(36)                       // points to full user after merge
  mergedAt       DateTime?

  // Relations
  sessions           Session[]
  devices            Device[]
  reminders          Reminder[]
  recurringReminders RecurringReminder[]
  subscription       Subscription?
  payments           Payment[]
  invoices           Invoice[]
  familyMemberships  FamilyMember[]
  chatParticipants   ChatParticipant[]
  sentMessages       ChatMessage[]        @relation("MessageSender")
  transactions       Transaction[]
  transactionCategories TransactionCategory[]
  analytics          Analytics[]
  notifications      Notification[]
  notificationLogs   NotificationLog[]
  smsDetections      SmsDetection[]
  settings           Settings?
  quotaTracking      QuotaTracking[]
  auditLogs          AuditLog[]
  accounts           Account[]
  budgets            Budget[]
  bills              Bill[]
  scannedBills       ScannedBill[]
  goals              Goal[]
  investments        Investment[]
  paymentMethods     PaymentMethod[]
  createdTasks       SharedTask[]         @relation("TaskCreator")
  assignedTasks      SharedTask[]         @relation("TaskAssignee")
  createdReminders   SharedReminder[]
  expenseGroups              ExpenseGroup[]
  expenseGroupMemberships    ExpenseGroupMember[]
  createdSharedGroups        SharedGroup[]        @relation("GroupCreator")
  sharedGroupMemberships     SharedGroupMember[]
  sharedExpenses             SharedExpense[]
  expenseSplits              ExpenseSplit[]
  settlementsFrom            Settlement[] @relation("SettlementFrom")
  settlementsTo              Settlement[] @relation("SettlementTo")
  salaryProfile              SalaryProfile?
  coupleProfileAsPartner1    CoupleFinanceProfile[] @relation("CouplePartner1")
  coupleProfileAsPartner2    CoupleFinanceProfile[] @relation("CouplePartner2")
  coupleFinanceInvites       CoupleFinanceInvite[]  @relation("InviteSender")
  receivedCoupleFinanceInvites CoupleFinanceInvite[] @relation("InviteReceiver")
  sharedSubscriptions        SharedSubscription[]
  subscriptionContributions  SubscriptionContribution[]
  tripExpenses               TripExpense[]
  groupChatMessages          GroupChatMessage[]
  groupChatReads             GroupChatRead[]
  householdBills             HouseholdBill[]
  householdContributions     HouseholdContribution[]
  sharedGoals                SharedGoal[]
  sharedGoalContributions    SharedGoalContribution[]
  reimbursementsFrom         ReimbursementLog[] @relation("ReimbursementFrom")
  reimbursementsTo           ReimbursementLog[] @relation("ReimbursementTo")
  groupInvites               GroupInvite[]
  tempInvites                TempInvite[]
  memberRemovalLogs          MemberRemovalLog[]
  sessionRevocations         SessionRevocation[]
  groupWallets                 GroupWallet[]
  walletTransactionsPerformed  GroupWalletTransaction[]
  walletTransactionsApproved   GroupWalletTransaction[] @relation("WalletApprover")
  walletMemberships            GroupWalletMember[]
  advanceContributionsPaid     AdvanceContribution[]
  advanceAdjustmentsMade       AdvanceAdjustment[]
  advanceContributionHistory   AdvanceContributionHistory[]
  expenseApprovalsRequested    ExpenseApproval[] @relation("ApprovalRequester")
  expenseApprovalsApproved     ExpenseApproval[] @relation("ApprovalApprover")
  expenseApprovalChanges       ExpenseApprovalHistory[]
  documentUploads              GroupDocument[]
  documentPermissions          DocumentPermission[]
  documentAuditLogs            DocumentAuditLog[]
  calendarEventsCreated        CalendarEvent[]
  splitTemplatesCreated        SplitTemplate[]
  creditCardBillsUploaded      CreditCardBill[]
  billSplits                   BillSplit[]
  cashPoolCustodian            CashPool[]
  cashTransactionsPerformed    CashTransaction[]
  emergencyFundsCreated        EmergencyFund[]
  emergencyContributions       EmergencyContribution[]
  emergencyWithdrawalsMade     EmergencyWithdrawal[]
  emergencyWithdrawalsApproved EmergencyWithdrawal[] @relation("WithdrawalApprover")
  userBadges                   UserBadge[]
  referralProgramsReferred     ReferralProgram[]
  referralProgramsReferee      ReferralProgram[] @relation("ReferredUser")
  premiumConversionEvents      PremiumConversionEvent[]
  exportHistories              ExportHistory[]

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ─── SESSIONS ──────────────────────────────────────────────
// User authentication sessions for refresh token management
model Session {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @db.VarChar(36)
  refreshToken String   @db.VarChar(500)
  userAgent   String?   @db.VarChar(500)
  ipAddress   String?   @db.VarChar(45)
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── DEVICES ───────────────────────────────────────────────
// User devices for push notifications and device management
model Device {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @db.VarChar(36)
  deviceId       String    @db.VarChar(255)
  platform       String?   @db.VarChar(50)    // ios, android, web
  pushToken      String?   @db.VarChar(500)
  deviceName     String?   @db.VarChar(255)
  appVersion     String?   @db.VarChar(20)
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([pushToken])
  @@map("devices")
}

// ─── REMINDERS ─────────────────────────────────────────────
// One-time reminders for bills, tasks, or events
model Reminder {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  type        String    @default("general") @db.VarChar(50)  // bill, task, event, general
  remindAt    DateTime
  dueDate     DateTime?
  startDate   DateTime?
  status      String    @default("active") @db.VarChar(20)   // active, completed, cancelled
  priority    String    @default("medium") @db.VarChar(10)   // low, medium, high, urgent
  isSent      Boolean   @default(false)
  sentAt      DateTime?
  isSnoozed   Boolean   @default(false)
  snoozedUntil DateTime?
  isRecurring Boolean   @default(false)
  categoryId  String?   @db.VarChar(36)
  deletedAt   DateTime?
  metadata    Json?     @db.Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  TransactionCategory? @relation(fields: [categoryId], references: [id])
  recurring RecurringReminder[]
  notifications Notification[]

  @@index([userId, remindAt])
  @@index([userId, isSent])
  @@index([remindAt, isSent])
  @@map("reminders")
}

// ─── RECURRING REMINDERS ───────────────────────────────────
// Recurring reminder patterns
model RecurringReminder {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  reminderId      String?  @db.VarChar(36)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  type            String   @default("general") @db.VarChar(50)
  frequency       String   @db.VarChar(20)
  interval        Int      @default(1)
  dayOfMonth      Int?
  daysOfWeek      String?  // JSON array for multi-day patterns
  monthOfYear     Int?
  time            String?  @db.VarChar(5)
  startDate       DateTime
  endDate         DateTime?
  occurrences     Int?     // Max number of occurrences
  count           Int      @default(0)  // How many times it has triggered
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  nextTriggerAt   DateTime?
  metadata        Json?    @db.Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id])

  @@unique([reminderId])
  @@index([userId, isActive])
  @@index([nextTriggerAt, isActive])
  @@map("recurring_reminders")
}

// ─── SUBSCRIPTION PLANS ────────────────────────────────────
// Available subscription tiers and pricing
model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.VarChar(36)
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD") @db.VarChar(10)
  interval      String   @db.VarChar(20)  // monthly, yearly
  features      Json     @db.Json
  maxAccounts   Int      @default(3)
  maxCategories Int      @default(20)
  maxBudgets    Int      @default(10)
  maxBills      Int      @default(20)
  maxGoals      Int      @default(10)
  maxInvestments Int     @default(5)
  maxFamilyMembers Int   @default(0)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@index([isDefault])
  @@map("subscription_plans")
}

// ─── SUBSCRIPTIONS ─────────────────────────────────────────
// User subscription assignments
model Subscription {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  planId          String    @db.VarChar(36)
  status          String    @default("active") @db.VarChar(20)  // active, cancelled, expired, trial, past_due
  trialEndsAt     DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt     DateTime?
  cancelAtPeriodEnd Boolean  @default(false)

  // Stripe fields
  stripeSubscriptionId  String?  @db.VarChar(255)
  stripePriceId         String?  @db.VarChar(255)

  // Razorpay fields
  razorpaySubscriptionId String? @db.VarChar(255)
  razorpayPlanId         String? @db.VarChar(255)

  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments   Payment[]
  invoices   Invoice[]

  @@unique([userId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@index([stripeSubscriptionId])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

// ─── PAYMENTS ──────────────────────────────────────────────
// Payment transactions for subscriptions
model Payment {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  subscriptionId  String    @db.VarChar(36)
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @db.VarChar(20)  // pending, completed, failed, refunded, partial_refund
  paymentMethod   String?   @db.VarChar(50)  // card, upi, netbanking, wallet, stripe, razorpay
  gateway         String?   @db.VarChar(20)  // stripe, razorpay

  // Stripe fields
  stripePaymentIntentId    String?  @db.VarChar(255)
  stripePaymentMethodId    String?  @db.VarChar(255)
  stripeChargeId           String?  @db.VarChar(255)

  // Razorpay fields
  razorpayPaymentId        String?  @db.VarChar(255)
  razorpayOrderId          String?  @db.VarChar(255)
  razorpaySignature        String?  @db.VarChar(255)

  receiptUrl      String?   @db.VarChar(500)
  failureMessage  String?   @db.Text
  failureCode     String?   @db.VarChar(100)
  paidAt          DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?  @db.Decimal(10, 2)
  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([stripePaymentIntentId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status, createdAt])
  @@map("payments")
}

// ─── INVOICES ──────────────────────────────────────────────
// Generated invoices for billing
model Invoice {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  subscriptionId  String    @db.VarChar(36)
  invoiceNumber   String    @unique @db.VarChar(50)
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @db.VarChar(20)  // draft, sent, paid, overdue, cancelled
  dueDate         DateTime
  paidAt          DateTime?
  pdfUrl          String?   @db.VarChar(500)
  lineItems       Json      @db.Json
  metadata        Json?     @db.Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([invoiceNumber])
  @@index([dueDate, status])
  @@map("invoices")
}

// ─── FAMILIES ──────────────────────────────────────────────
// Family/group sharing accounts
model Family {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @db.VarChar(255)
  code        String?   @unique @db.VarChar(20)  // Invite code
  ownerId     String    @db.VarChar(36)
  maxMembers  Int       @default(5)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  members   FamilyMember[]
  tasks     SharedTask[]
  reminders SharedReminder[]

  @@index([code])
  @@index([ownerId])
  @@map("families")
}

// ─── FAMILY MEMBERS ────────────────────────────────────────
// Family membership mapping
model FamilyMember {
  id        String   @id @default(uuid()) @db.VarChar(36)
  familyId  String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  role      String   @default("member") @db.VarChar(20)  // owner, admin, member, viewer
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId, role])
  @@index([userId])
  @@map("family_members")
}

// ─── CHATS ─────────────────────────────────────────────────
// Chat/conversation threads
model Chat {
  id         String   @id @default(uuid()) @db.VarChar(36)
  title      String?  @db.VarChar(255)
  type       String   @default("direct") @db.VarChar(20)  // direct, group, family
  createdBy  String   @db.VarChar(36)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  messages ChatMessage[]
  participants ChatParticipant[]

  @@index([createdBy])
  @@index([type])
  @@map("chats")
}

// ─── CHAT PARTICIPANTS ─────────────────────────────────────
model ChatParticipant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  chatId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, isActive])
  @@map("chat_participants")
}

// ─── CHAT MESSAGES ─────────────────────────────────────────
// Individual messages within chats
model ChatMessage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  chatId    String   @db.VarChar(36)
  senderId  String   @db.VarChar(36)
  content   String   @db.Text
  messageType String @default("text") @db.VarChar(20)  // text, image, file, system
  mediaUrl  String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  readAt    DateTime?
  isEdited  Boolean  @default(false)
  editedAt  DateTime?
  replyToId String?  @db.VarChar(36)
  metadata  Json?    @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chat     Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender   User        @relation("MessageSender", fields: [senderId], references: [id])
  replyTo  ChatMessage? @relation("MessageReply", fields: [replyToId], references: [id])
  replies  ChatMessage[] @relation("MessageReply")

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([chatId, isRead])
  @@index([messageType])
  @@map("chat_messages")
}

// ─── SHARED TASKS ──────────────────────────────────────────
// Tasks shared within families/groups
model SharedTask {
  id          String    @id @default(uuid()) @db.VarChar(36)
  familyId    String    @db.VarChar(36)
  createdById String    @db.VarChar(36)
  assignedToId String?  @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(20)  // pending, in_progress, completed, cancelled
  priority    String    @default("medium") @db.VarChar(10)   // low, medium, high, urgent
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  completedById String? @db.VarChar(36)
  isRecurring Boolean   @default(false)
  frequency   String?   @db.VarChar(20)
  metadata    Json?     @db.Json
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([familyId, status])
  @@index([assignedToId, status])
  @@index([dueDate, status])
  @@map("shared_tasks")
}

// ─── SHARED REMINDERS ─────────────────────────────────────
// Reminders shared within families
model SharedReminder {
  id          String    @id @default(uuid()) @db.VarChar(36)
  familyId    String    @db.VarChar(36)
  createdById String    @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  remindAt    DateTime
  isSent      Boolean   @default(false)
  isRecurring Boolean   @default(false)
  frequency   String?   @db.VarChar(20)
  metadata    Json?     @db.Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([familyId, remindAt])
  @@index([familyId, isSent])
  @@map("shared_reminders")
}

// ─── ACCOUNTS ──────────────────────────────────────────────
// Financial accounts (bank, credit card, cash, investment, etc.)
model Account {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(20)   // checking, savings, credit_card, cash, investment, loan, wallet
  currency        String   @default("USD") @db.VarChar(10)
  balance         Decimal  @default(0) @db.Decimal(15, 2)
  initialBalance  Decimal  @default(0) @db.Decimal(15, 2)
  creditLimit     Decimal? @db.Decimal(15, 2)
  color           String?  @db.VarChar(50)
  icon            String?  @db.VarChar(50)
  isActive        Boolean  @default(true)
  isArchived      Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  lastSyncedAt    DateTime?
  description     String?  @db.VarChar(500)
  institution     String?  @db.VarChar(255)
  lastFourDigits  String?  @db.VarChar(4)
  sortOrder       Int      @default(0)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  investments  Investment[]

  @@index([userId, isActive])
  @@index([userId, type])
  @@index([userId, isArchived])
  @@map("accounts")
}

// ─── TRANSACTION CATEGORIES ────────────────────────────────
// Hierarchical transaction categories
model TransactionCategory {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          String    @db.VarChar(36)
  name            String    @db.VarChar(100)
  transactionType String    @db.VarChar(10)   // income, expense
  icon            String?   @db.VarChar(50)
  color           String?   @db.VarChar(50)
  parentId        String?   @db.VarChar(36)
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       TransactionCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     TransactionCategory[] @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  bills        Bill[]
  reminders    Reminder[]

  @@index([userId, transactionType])
  @@index([userId, parentId])
  @@index([userId, isActive])
  @@index([name, userId])
  @@map("transaction_categories")
}

// ─── TRANSACTIONS ──────────────────────────────────────────
// Core financial transactions (income, expense, transfers)
model Transaction {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  userId             String    @db.VarChar(36)
  accountId          String?   @db.VarChar(36)
  categoryId         String?   @db.VarChar(36)
  amount             Decimal   @db.Decimal(15, 2)
  type               String    @db.VarChar(10)    // income, expense, transfer
  status             String    @default("completed") @db.VarChar(20)  // completed, pending, cancelled
  date               DateTime  @db.Date
  description        String?   @db.VarChar(500)
  notes              String?   @db.Text
  tags               Json?     @db.Json
  isRecurring        Boolean   @default(false)
  recurringId        String?   @db.VarChar(36)
  recurringFrequency String?   @db.VarChar(20)
  recurringEndDate   DateTime? @db.Date
  receiptUrl         String?   @db.VarChar(500)
  exchangeRate       Decimal?  @db.Decimal(10, 6)
  originalCurrency   String?   @db.VarChar(10)
  originalAmount     Decimal?  @db.Decimal(15, 2)
  transferToAccountId String?  @db.VarChar(36)
  isReviewed         Boolean   @default(false)
  isSplit            Boolean   @default(false)
  parentTransactionId String?  @db.VarChar(36)
  expenseGroupId     String?   @db.VarChar(36)
  metadata           Json?     @db.Json
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?            @relation(fields: [accountId], references: [id])
  category      TransactionCategory? @relation(fields: [categoryId], references: [id])
  expenseGroup  ExpenseGroup?       @relation(fields: [expenseGroupId], references: [id])
  splitTransactions Transaction[]   @relation("SplitTransaction")
  parentTransaction Transaction?    @relation("SplitTransaction", fields: [parentTransactionId], references: [id])

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([userId, type, date])
  @@index([userId, status])
  @@index([userId, isReviewed])
  @@index([expenseGroupId, date])
  @@index([date, status])
  @@map("transactions")
}

