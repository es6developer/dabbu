{
  "version": 2,
  "rootDirectory": "apps/backend",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "API_PREFIX": "/api/v1",
    "API_PORT": "4000",
    "HUSKY": "0"
  }
}
