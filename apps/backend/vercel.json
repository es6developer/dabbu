{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production",
    "API_PREFIX": "/api/v1",
    "API_PORT": "4000"
  }
}
