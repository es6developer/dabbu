{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
