# ─── PRODUCTION ENVIRONMENT FOR DABBU BACKEND (Vercel) ───
# Copy this to Vercel Environment Variables dashboard or .env.production
# ❗ Replace ALL placeholder values marked with CHANGE_ME

# ─── App ───────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=/api/v1
API_PORT=4000
PORT=4000
APP_URL=https://your-backend.vercel.app                          # CHANGE_ME: your Vercel deployment URL
FRONTEND_URL=https://your-frontend.vercel.app                     # CHANGE_ME: your frontend URL
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:8081
LOG_LEVEL=error
LOG_DIR=/tmp/logs
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
SERVICE_NAME=dabbu-api

# ─── Rate Limiting ──────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# ─── Database (MySQL / Aiven or Planetscale) ───────────────
# IMPORTANT: Vercel serverless needs connection pooling (use ?pool timeout params)
# For PlanetScale, use: mysql://user:pass@aws.connect.psdb.cloud/db?sslaccept=strict
# For Aiven (current), the URL already has connection_limit appended by PrismaService
DATABASE_URL=mysql://user:CHANGE_ME@host:port/db?sslmode=require # CHANGE_ME
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_DATABASE=CHANGE_ME

# ─── Redis (optional on Vercel — skip if not using queues) ──
# Vercel serverless doesn't support persistent Redis connections.
# Use Upstash Redis (HTTPS-based) or skip background jobs.
# If not using queues, these can be left as-is; BullMQ will degrade gracefully.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_chars_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_random_64_chars_here_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=dabbu
JWT_AUDIENCE=dabbu-users

# ─── Encryption ─────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_char_encryption_key_here_xxxxxx

# ─── Firebase (Push notifications + auth) ──────────────────
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@CHANGE_ME.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME_whole_key_here\n-----END PRIVATE KEY-----\n"

# ─── Payment Gateways ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ─── Email (Primary: Resend | Fallback: SMTP) ─────────────
# Resend is preferred for Vercel. Get a free key at https://resend.com
RESEND_API_KEY=re_CHANGE_ME

# SMTP fallback (unused if RESEND_API_KEY is set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME
SMTP_EMAIL=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=CHANGE_ME@gmail.com
EMAIL_FROM_NAME=Dabbu

# ─── AI / ML ───────────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-CHANGE_ME
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# ─── External APIs ─────────────────────────────────────────
EXCHANGE_RATE_API_KEY=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_ID_EXT_WEB=CHANGE_ME.apps.googleusercontent.com

# ─── Sentry (Error tracking) ──────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
SENTRY_ENABLE_TRACING=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ─── OpenTelemetry ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Expo Push Notifications ────────────────────────────────
# Generate an access token at https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=q7VY02bp3asjBwcLupSHaOP4OA6IXaOzCk8OXQCg

# ─── Document Uploads ─────────────────────────────────────
DOCUMENT_UPLOAD_DIR=/tmp/uploads

# ─── Vercel-specific ──────────────────────────────────────
VERCEL=true
